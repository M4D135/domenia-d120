+function Complete-AdccDetachedReadJobs {
+    # Never call Dispose/EndInvoke on a running native operation on the UI thread.
+    if ($null -eq $script:DetachedReadJobs) { return }
+    for ($i = $script:DetachedReadJobs.Count - 1; $i -ge 0; $i--) {
+        $job = $script:DetachedReadJobs[$i]
+        if ($null -eq $job) { $script:DetachedReadJobs.RemoveAt($i); continue }
+        $invokeDone = $false; $stopDone = $true
+        try { $invokeDone = [bool]$job.Handle.IsCompleted } catch { }
+        try { if ($null -ne $job.StopHandle) { $stopDone = [bool]$job.StopHandle.IsCompleted } } catch { $stopDone = $false }
+        if (-not $invokeDone -or -not $stopDone) { continue }
+        try { if ($null -ne $job.StopHandle) { $job.PowerShell.EndStop($job.StopHandle) } } catch { }
+        try { $discarded = $job.PowerShell.EndInvoke($job.Handle); $discarded = $null } catch { }
+        try { $job.PowerShell.Dispose() } catch { }
+        try { $job.Runspace.Dispose() } catch { }
+        $job.OnSuccess = $null; $job.OnError = $null; $job.CallbackState = $null
+        $script:DetachedReadJobs.RemoveAt($i)
+    }
+}
+
+function Get-AdccRuntimeHealthText {
+    $lines = New-Object 'System.Collections.Generic.List[string]'
+    $process = [Diagnostics.Process]::GetCurrentProcess()
+    try {
+        $lines.Add("ADCC $script:Version / $script:MasterBuild")
+        $lines.Add('Genere le ' + (Get-Date -Format 'yyyy-MM-dd HH:mm:ss'))
+        $lines.Add('PowerShell : ' + [string]$PSVersionTable.PSVersion + ' ; 64 bits : ' + [Environment]::Is64BitProcess)
+        $lines.Add('Memoire privee : ' + [Math]::Round($process.PrivateMemorySize64 / 1MB,1) + ' Mo')
+        $lines.Add('Lecture seule : ' + [string]$script:ReadOnlyMode + ' ; etat ecriture : ' + [string]$script:WriteState)
+        $lines.Add('Cache actif : ' + (Get-AdccDatabasePath))
+        $lines.Add('Taches actives : ' + @($script:AsyncJobs.Keys).Count)
+        $lines.Add('Lectures en attente de nettoyage : ' + @($script:DetachedReadJobs).Count)
+        $lines.Add('')
+        foreach ($job in @($script:AsyncJobs.Values) + @($script:DetachedReadJobs)) {
+            if ($null -eq $job) { continue }
+            $age = [int]((Get-Date) - [datetime]$job.Started).TotalSeconds
+            $lines.Add(('{0} | {1}s | ecriture={2} | annulation={3} | {4}' -f $job.OperationId,$age,$job.IsWrite,$job.CancelRequested,$job.CorrelationId))
+        }
+        $lines.Add('')
+        $lines.Add('Une lecture detachee ne renvoie plus de resultat dans le GUI, mais son appel natif peut encore etre actif.')
+        $lines.Add('Les taches natives encore actives comptent dans la limite physique de concurrence.')
+        return Protect-AdccLogText ([string]::Join([Environment]::NewLine,$lines.ToArray()))
+    } finally { $process.Dispose() }
+}
+
+function Register-AdccReliabilityUi {
+    $copy = Get-AdccControl -Name 'BtnCopyUiLog'
+    if ($null -ne $copy) { $copy.Add_Click({
+        try {
+            $box = Get-AdccControl -Name 'TxtUiLog'
+            if ($null -ne $box -and -not [string]::IsNullOrWhiteSpace([string]$box.Text)) {
+                Set-ClipboardSafe (Protect-AdccLogText ([string]$box.Text))
+                Set-Status 'Journal copie. Les noms de comptes et de machines ne sont pas anonymises.'
+            }
+        } catch { Show-ErrorBox $_.Exception.Message }
+    }) }
+    $health = Get-AdccControl -Name 'BtnRuntimeHealth'
+    if ($null -ne $health) { $health.Add_Click({
+        try { Show-InfoBox -Message 'Etat du moteur ADCC' -Details (Get-AdccRuntimeHealthText) }
+        catch { Show-ErrorBox $_.Exception.Message }
+    }) }
+    if ($null -ne $script:Window) { $script:Window.Add_Deactivated({
+        if ([bool]$script:SecretsVisible) { $script:SecretsVisible = $false; Update-SecretsGrid }
+    }) }
+}
+
+function Restart-AdccSecretLifetime {
+    try { if ($null -ne $script:SecretLifetimeTimer) { $script:SecretLifetimeTimer.Stop() } } catch { }
+    $seconds = [Math]::Max(30,[Math]::Min(1800,[int](Get-CfgValue 'Security' 'SecretMemorySeconds' 300)))
+    $timer = New-Object System.Windows.Threading.DispatcherTimer
+    $timer.Interval = [TimeSpan]::FromSeconds($seconds)
+    $timer.Add_Tick({
+        try { Clear-Secrets; Set-Status 'Secrets retires de la vue et references effacees apres expiration.' }
+        catch { Write-AppLog 'Expiration des secrets : echec du nettoyage.' 'WARN' }
+    })
+    $script:SecretLifetimeTimer = $timer
+    $timer.Start()
+}
+
+function Get-AdccSelectedSecretSource {
+    $grid = Get-AdccControl -Name 'DgSecrets'
+    if ($null -eq $grid -or $null -eq $grid.SelectedItem) { return $null }
+    $row = $grid.SelectedItem
+    if ($null -eq $row.PSObject.Properties['SecretIndex']) { return $null }
+    $index = [int]$row.SecretIndex
+    if ($index -lt 0 -or $index -ge @($script:SecretRows).Count) { return $null }
+    return $script:SecretRows[$index]
+}
+
+function Assert-AdccWmiReadQuery {
+    param([string]$ClassName,[string]$Namespace,[string]$Where,[int]$Limit)
+    if ($ClassName -notmatch '^[A-Za-z_][A-Za-z0-9_]{0,127}$') { throw 'Nom de classe WMI invalide.' }
+    if ($Namespace -notmatch '^root(?:\\[A-Za-z_][A-Za-z0-9_]*)*$') { throw 'Espace de noms WMI invalide.' }
+    if ($ClassName -ieq 'Win32_Product') { throw 'Win32_Product est bloque : sa lecture peut declencher des verifications/reparations MSI. Utilise le panneau Logiciels.' }
+    if (([string]$Where).Length -gt 2048 -or ([string]$Where).IndexOf([char]0) -ge 0) { throw 'Filtre WMI trop long ou contenant un caractere nul.' }
+    if ($Limit -lt 1 -or $Limit -gt 500) { throw 'La limite WMI doit etre comprise entre 1 et 500.' }
+}
