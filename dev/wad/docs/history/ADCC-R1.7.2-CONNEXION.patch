+    function Get-AuthNativeFailure {
+        param($Record)
+        $deep=Get-DeepestException -ErrorRecord $Record
+        $hr=''; $nativeMessage=''; $extendedCode=''; $extendedMessage=''; $ldapCode=''
+        try { if ($null -ne $deep) { $hr=('0x{0:X8}' -f $deep.HResult); $nativeMessage=[string]$deep.Message } } catch { }
+        $cursor=$null
+        try { $cursor=$Record.Exception } catch { }
+        if ($null -eq $cursor -and $Record -is [System.Exception]) { $cursor=$Record }
+        for ($i=0; $null -ne $cursor -and $i -lt 12; $i++) {
+            if ($cursor -is [System.DirectoryServices.Protocols.LdapException]) {
+                $ldapCode=[string]$cursor.ErrorCode
+                $extendedMessage=[string]$cursor.ServerErrorMessage
+            }
+            if ($cursor -is [System.DirectoryServices.DirectoryServicesCOMException]) {
+                $extendedCode=[string]$cursor.ExtendedError
+                $extendedMessage=[string]$cursor.ExtendedErrorMessage
+            }
+            $cursor=$cursor.InnerException
+        }
+        $category=''; $summary=''
+        switch ($hr) {
+            '0x80070525' { $category='Credentials'; $summary='Compte inconnu du fournisseur d authentification.' }
+            '0x8007052E' { $category='Credentials'; $summary='Identifiant ou mot de passe refuse. Le code ne distingue pas les deux.' }
+            '0x8007052F' { $category='AccountRestriction'; $summary='Une restriction du compte interdit cette connexion.' }
+            '0x80070530' { $category='AccountRestriction'; $summary='Connexion interdite a cette heure pour ce compte.' }
+            '0x80070531' { $category='AccountRestriction'; $summary='Connexion interdite depuis ce poste pour ce compte.' }
+            '0x80070532' { $category='AccountRestriction'; $summary='Le mot de passe de ce compte a expire.' }
+            '0x80070533' { $category='AccountRestriction'; $summary='Ce compte est desactive.' }
+            '0x80070701' { $category='AccountRestriction'; $summary='Ce compte a expire.' }
+            '0x80070773' { $category='AccountRestriction'; $summary='Ce compte doit changer de mot de passe avant la connexion.' }
+            '0x80070775' { $category='AccountRestriction'; $summary='Ce compte est verrouille. Arrete les essais et verifie son etat.' }
+            '0x80070005' { $category='AccessDenied'; $summary='Acces refuse pendant cette etape.' }
+            '0x8007051F' { $category='DomainUnavailable'; $summary='Aucun serveur d ouverture de session disponible.' }
+            '0x8007054B' { $category='DomainUnavailable'; $summary='Le domaine n existe pas ou ne peut pas etre contacte.' }
+            '0x8007203A' { $category='DomainUnavailable'; $summary='Le serveur d annuaire n est pas operationnel.' }
+            '0x800705B4' { $category='Timeout'; $summary='Le delai de l operation est depasse.' }
+        }
+        return [pscustomobject]@{
+            HResult=$hr; Category=$category; Summary=$summary; NativeMessage=$nativeMessage
+            ExtendedCode=$extendedCode; ExtendedMessage=$extendedMessage; LdapCode=$ldapCode
+        }
+    }
