{
  "$schema": "../scenario.schema.json",
  "name": "Accueil : choisir et appliquer l’OU de travail",
  "description": "Ouvre « Choisir l’OU » (panneau et arborescence du kit) depuis la carte de l’OU de travail, déplie l’OU Postes au clavier, sélectionne Lyon, l’applique, puis vérifie que l’Accueil est recalculé sur cette OU sans lecture réseau.",
  "modes": ["simulation"],
  "start": "accueil",
  "steps": [
    { "do": "expect", "text": "Postes", "within": ".scope-card .scope-name", "title": "L’OU de travail de départ est « Postes »" },
    { "do": "expect", "contains": "Vue d’ensemble · OU Postes", "within": ".hero h1", "title": "Le titre est le périmètre, sans salutation" },
    { "do": "expect", "contains": "EXAMPLE\\adm-j.martin", "within": ".hero .chips", "title": "Le compte d’administration est une puce" },
    { "do": "click", "text": "Choisir l’OU", "within": ".scope-card" },
    { "do": "expect", "selector": ".k-drw[role=dialog]", "title": "Le panneau « Choisir l’OU de travail » est ouvert" },
    { "do": "wait", "text": "Postes", "within": ".acc-ou .k-tree", "title": "L’arborescence des OU est lue" },
    { "do": "click", "text": "Postes", "within": ".acc-ou .k-tree", "title": "Sélectionner l’OU Postes dans l’arborescence" },
    { "do": "press", "key": "ArrowRight", "title": "Déplier Postes au clavier (flèche droite)" },
    { "do": "click", "text": "Lyon", "within": ".acc-ou .k-tree", "title": "Sélectionner l’OU Lyon sous Postes" },
    { "do": "expect", "contains": "Lyon", "within": ".acc-ou .ou-pick", "title": "La sélection affiche Lyon" },
    { "do": "expect", "selector": "[data-id=apply]", "within": ".k-drw-foot", "property": "disabled", "equals": false, "title": "« Appliquer » est disponible" },
    { "do": "shot", "name": "panneau-ou", "selector": ".k-drw" },
    { "do": "click", "text": "Appliquer", "within": ".k-drw-foot" },
    { "do": "expect", "selector": ".k-drw", "absent": true, "title": "Le panneau se referme" },
    { "do": "expect", "text": "Lyon", "within": ".scope-card .scope-name", "title": "La carte affiche la nouvelle OU de travail" },
    { "do": "expect", "contains": "OU de travail : Lyon et ses sous-OU.", "within": ".toasts", "title": "La notification confirme le recalcul sans lecture réseau" },
    { "do": "expect", "contains": "Tableau du parc · OU Lyon", "within": "[data-sec=board]", "title": "Le tableau du parc porte sur Lyon" },
    { "do": "journal", "contains": "Mode E2E actif" },
    { "do": "journal", "contains": "[ERREUR]", "absent": true }
  ]
}
