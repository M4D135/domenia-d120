<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="OperationsPanel" Width="620" MaxHeight="560" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="14,12"
        CornerRadius="12" BorderThickness="1" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderColor}"
        KeyboardNavigation.TabNavigation="Cycle" AutomationProperties.Name="Opérations"
        AutomationProperties.HelpText="Opérations en cours et en attente de cette session, leur durée, les dernières opérations avec leurs étapes et la santé du moteur. Échap ou un clic à côté ferme le panneau ; les opérations continuent.">
  <!-- W13 (point 113): the panel scrolls as a whole when the window is short (RDP, zoom): no button leaves the screen. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="Opérations" FontSize="{DynamicResource FontSizeSection}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextColor}"/>
      <Button x:Name="BtnOperationsClose" Grid.Column="1" Content="Fermer" MinHeight="30" Padding="10,2" ToolTip="Ferme ce panneau. Les opérations continuent et restent comptées sur le bouton Opérations."
              ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Fermer le panneau des opérations"
              AutomationProperties.HelpText="Ferme ce panneau. Les opérations continuent et restent comptées sur le bouton Opérations."/>
    </Grid>
    <!-- W13 (point 118) with X04/X05: the operations and what waits for the operator in one place. The receipts that wait
         for a check are counted by the same rule as the header pill (Get-DomeniaPendingOperationsView) and open the same list. -->
    <DockPanel Grid.Row="1" LastChildFill="True" Margin="0,8,0,8">
      <Button x:Name="BtnOperationsReceipts" DockPanel.Dock="Right" Visibility="Collapsed" Content="1 opération à vérifier" MinHeight="28" Padding="10,2" Margin="8,0,0,0" VerticalAlignment="Center"
              Background="{DynamicResource InfoBg}" BorderBrush="{DynamicResource StatusWarning}" Foreground="{DynamicResource InfoFg}"
              ToolTip="Écritures envoyées qui attendent une vérification ou une revue, comptées comme sur la pastille de lʼen-tête : les nouvelles écritures restent bloquées. Ferme ce panneau et ouvre la liste des reçus ; rien nʼest rejoué."
              ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Opérations à vérifier"
              AutomationProperties.HelpText="Écritures envoyées qui attendent une vérification ou une revue, comptées comme sur la pastille de lʼen-tête : les nouvelles écritures restent bloquées. Ferme ce panneau et ouvre la liste des reçus ; rien nʼest rejoué."/>
      <TextBlock x:Name="LblSuiteActivityState" Text="" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource MutedColor}" AutomationProperties.LiveSetting="Polite"/>
    </DockPanel>
    <DataGrid x:Name="DgSuiteActivity" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
              MinRowHeight="32" MinHeight="96" MaxHeight="300" CanUserAddRows="False" CanUserDeleteRows="False"
              ToolTip="Opérations de cette session : en cours, en attente, arrêt demandé, à vérifier ou nettoyage. Une ligne qui disparaît ne prouve pas un résultat ; consultez le journal."
              ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Opérations en cours"
              AutomationProperties.HelpText="Opérations de cette session : en cours, en attente, arrêt demandé, à vérifier ou nettoyage. Une ligne qui disparaît ne prouve pas un résultat ; consultez le journal.">
      <DataGrid.RowStyle>
        <Style TargetType="DataGridRow">
          <Setter Property="ToolTip" Value="{Binding Detail}"/>
        </Style>
      </DataGrid.RowStyle>
      <DataGrid.Columns>
        <DataGridTextColumn Header="Opération" Binding="{Binding Name}" Width="2*"/>
        <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="90"/>
        <DataGridTextColumn Header="État" Binding="{Binding State}" Width="110"/>
        <DataGridTextColumn Header="Durée" Binding="{Binding Duration}" Width="70"/>
        <DataGridTemplateColumn Header="" Width="96">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Button Content="Arrêter" Tag="{Binding Id}" IsEnabled="{Binding CanCancel}" MinHeight="26" Padding="8,0" Margin="2"
                      ToolTip="Demande lʼarrêt de cette lecture. Une écriture envoyée ou un enregistrement local ne sʼarrêtent pas ; un appel natif peut encore finir son nettoyage."
                      ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Arrêter cette opération"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
    <!-- W13 (points 118, 123): the last operations of the session, their measured steps and what can be done next. -->
    <TextBlock Grid.Row="3" Text="Dernières opérations" FontWeight="SemiBold" Margin="0,12,0,4" Foreground="{DynamicResource TextColor}"/>
    <DataGrid x:Name="DgOperationsRecent" Grid.Row="4" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
              MinRowHeight="28" MinHeight="64" MaxHeight="220" CanUserAddRows="False" CanUserDeleteRows="False"
              ToolTip="Opérations de cette session, la plus récente en haut : état, durée, étape la plus longue et référence à chercher dans Domenia.log. Gardées en mémoire seulement, 64 au plus."
              ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Dernières opérations"
              AutomationProperties.HelpText="Opérations de cette session, la plus récente en haut : état, durée, étape la plus longue et référence à chercher dans Domenia.log. Gardées en mémoire seulement, 64 au plus.">
      <DataGrid.RowStyle>
        <Style TargetType="DataGridRow">
          <Setter Property="ToolTip" Value="{Binding Detail}"/>
          <Setter Property="AutomationProperties.Name" Value="{Binding Detail}"/>
        </Style>
      </DataGrid.RowStyle>
      <DataGrid.Columns>
        <DataGridTextColumn Header="État" Binding="{Binding State}" Width="150"/>
        <DataGridTextColumn Header="Opération" Binding="{Binding Name}" Width="2*"/>
        <DataGridTextColumn Header="Durée" Binding="{Binding Duration}" Width="70"/>
        <DataGridTextColumn Header="Surtout" Binding="{Binding Phase}" Width="120"/>
        <DataGridTextColumn Header="Réf." Binding="{Binding Reference}" Width="76"/>
      </DataGrid.Columns>
    </DataGrid>
    <TextBlock x:Name="LblOperationsTrace" Grid.Row="5" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource MutedColor}" AutomationProperties.LiveSetting="Polite"
               Text="Sélectionnez une opération pour lire ses étapes : demande, file dʼattente, collecte, validation, lecture locale et publication."
               ToolTip="Étapes mesurées de lʼopération choisie et ce qui peut être fait ensuite. Aucune relance automatique."
               AutomationProperties.Name="Étapes de lʼopération choisie"
               AutomationProperties.HelpText="Étapes mesurées de lʼopération choisie et ce qui peut être fait ensuite. Aucune relance automatique."/>
    <WrapPanel Grid.Row="6" Margin="0,6,0,0">
      <Button x:Name="BtnOperationsCopyTrace" Content="Copier le détail" MinHeight="28" Padding="10,2" Margin="0,0,6,0" IsEnabled="False"
              ToolTip="Copie le détail de lʼopération choisie : étapes, durées et référence. Le nom de la cible peut y figurer : relisez avant envoi."
              ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Copier le détail de lʼopération"
              AutomationProperties.HelpText="Copie le détail de lʼopération choisie : étapes, durées et référence. Le nom de la cible peut y figurer : relisez avant envoi."/>
      <Button x:Name="BtnOperationsJournal" Content="Ouvrir le journal" MinHeight="28" Padding="10,2" Margin="0,0,6,0"
              ToolTip="Ferme ce panneau et ouvre le journal de session. Les références des opérations figurent aussi dans Domenia.log."
              ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Ouvrir le journal"
              AutomationProperties.HelpText="Ferme ce panneau et ouvre le journal de session. Les références des opérations figurent aussi dans Domenia.log."/>
      <Button x:Name="BtnOperationsDiagnostic" Content="Diagnostic expurgé…" MinHeight="28" Padding="10,2"
              ToolTip="Prépare le diagnostic expurgé (versions, mesures locales, codes dʼerreur, traces sans cible), le montre en entier, puis lʼenregistre dans un fichier local après confirmation. Aucun envoi."
              ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Diagnostic expurgé"
              AutomationProperties.HelpText="Prépare le diagnostic expurgé (versions, mesures locales, codes dʼerreur, traces sans cible), le montre en entier, puis lʼenregistre dans un fichier local après confirmation. Aucun envoi."/>
    </WrapPanel>
    <Border Grid.Row="7" Background="{DynamicResource TileBg}" CornerRadius="10" Padding="12,8" Margin="0,10,0,0">
      <StackPanel>
        <TextBlock Text="Santé" FontWeight="SemiBold" Foreground="{DynamicResource TextColor}"/>
        <TextBlock x:Name="LblOperationsHealth" Text="" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource MutedColor}"
                   ToolTip="Mesures locales de cette session : mémoire, réactivité de lʼinterface, temps de réponse par catégorie (recherche locale, interface, base locale, annuaire, postes, écritures et actions : médiane, 95e centile à partir de 20 mesures, maximum), lenteurs expliquées par opération et par étape, dernière sauvegarde locale. Aucune sonde réseau."
                   AutomationProperties.Name="Santé du moteur"
                   AutomationProperties.HelpText="Mesures locales de cette session : mémoire, réactivité de lʼinterface, temps de réponse par catégorie (recherche locale, interface, base locale, annuaire, postes, écritures et actions : médiane, 95e centile à partir de 20 mesures, maximum), lenteurs expliquées par opération et par étape, dernière sauvegarde locale. Aucune sonde réseau."/>
      </StackPanel>
    </Border>
  </Grid>
  </ScrollViewer>
</Border>
