<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="DomeniaQueryView">
  <Grid x:Name="UxQueryLayout" Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <DockPanel x:Name="UxQueryScopeBar" Margin="0,0,0,8">
      <Button x:Name="BtnQueryBack" DockPanel.Dock="Left" Content="Retour" MinHeight="32" Margin="0,0,12,0" AutomationProperties.Name="Revenir à la vue précédente" />
      <TextBlock x:Name="LblQueryScope" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource MutedColor}" />
    </DockPanel>
    <Border x:Name="UxQueryCard" Style="{DynamicResource Card}" Grid.Row="1">
      <DockPanel x:Name="UxQueryCardLayout" Margin="0,8,0,0">
        <StackPanel x:Name="UxQueryHeader" DockPanel.Dock="Top" Margin="0,0,0,10">
          <WrapPanel Margin="0,0,0,6">
            <ComboBox x:Name="CmbFleetQuery" Width="330" MinHeight="32" Margin="0,0,6,0" AutomationProperties.Name="Requêtes personnelles récentes" ToolTip="Accès rapide aux 100 dernières requêtes personnelles. Tous les modèles et toutes vos requêtes sont dans Bibliothèque." />
            <Button x:Name="BtnQueryLoad" Content="Charger" MinHeight="32" Margin="0,0,6,0" />
            <Button x:Name="BtnQueryNew" Content="Nouvelle" MinHeight="32" Margin="0,0,6,0" />
            <Button x:Name="BtnQueryRun" Content="Aperçu local" Style="{DynamicResource RunButton}" MinHeight="32" Margin="8,0,0,0" />
          </WrapPanel>
          <TextBlock x:Name="LblQueryStatus" Text="Choisissez un modèle, ou ajoutez des conditions." TextWrapping="Wrap" Margin="0,4,0,8" Foreground="{DynamicResource MutedColor}" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <TabControl x:Name="QueryWorkspaceTabs" Margin="0,4,0,0" SelectedIndex="1">
          <TabItem x:Name="TabQueryResults" Header="2. Aperçu">
            <DockPanel x:Name="UxQueryResultsLayout" Margin="10">
              <WrapPanel Margin="0,0,0,6" DockPanel.Dock="Top">
                <TextBlock x:Name="LblQuerySegment" MaxWidth="740" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource MutedColor}" />
                <Button x:Name="BtnQueryClearSegment" Content="Retirer le segment" MinHeight="30" Margin="8,0,0,0" />
              </WrapPanel>
              <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBox x:Name="TxtFleetMachineFilter" Width="220" MinHeight="32" Margin="0,0,8,0" ToolTip="Filtre local par nom ou unité organisationnelle. Aucun accès réseau." AutomationProperties.Name="Filtrer les postes de lʼatelier" />
                <ComboBox x:Name="CmbFleetMachineState" Width="140" MinHeight="32" SelectedIndex="0" ToolTip="Inclure tous les postes ou filtrer les comptes actifs et désactivés." AutomationProperties.Name="État des postes affichés">
                  <ComboBoxItem Content="Tous les états" />
                  <ComboBoxItem Content="Actifs" />
                  <ComboBoxItem Content="Désactivés" />
                </ComboBox>
                <ComboBox x:Name="CmbQueryResult" Width="150" MinHeight="32" Margin="8,0,0,0" SelectedIndex="0" AutomationProperties.Name="Type de résultat à afficher">
                  <ComboBoxItem Content="Correspondants" />
                  <ComboBoxItem Content="Inconnus" />
                  <ComboBoxItem Content="Non correspondants" />
                </ComboBox>
                <TextBlock x:Name="LblFleetMachineCount" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource MutedColor}" />
              </WrapPanel>
              <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                <Button x:Name="BtnQueryPrevious" Content="Page précédente" IsEnabled="False" MinHeight="30" Margin="0,0,6,0" />
                <Button x:Name="BtnQueryNext" Content="Page suivante" IsEnabled="False" MinHeight="30" Margin="0,0,6,0" />
                <Button x:Name="BtnQueryContinueSave" Content="Enregistrer ou réutiliser →" MinHeight="30" Margin="0,0,6,0" />
                <Button x:Name="BtnQueryExport" Content="Tout exporter (CSV)" IsEnabled="False" ToolTip="Exporter toutes les lignes du résultat calculé, avec les critères et le périmètre." MinHeight="30" />
              </WrapPanel>
              <Expander x:Name="ExpQueryObject" DockPanel.Dock="Bottom" Header="Objet sélectionné · fiche locale" IsExpanded="False" Margin="0,10,0,0">
                <StackPanel>
                  <TextBlock x:Name="LblQueryObject" Text="Sélectionnez un poste pour consulter ses données." TextWrapping="Wrap" Margin="0,4,0,8" />
                  <WrapPanel Margin="0,0,0,6">
                    <Button x:Name="BtnQueryObjectOpen" Content="Fiche AD et actions…" MinHeight="32" Margin="0,0,6,0" ToolTip="Relit cet objet par son DN et vérifie son GUID avant dʼouvrir les actions protégées." />
                    <Button x:Name="BtnQueryObjectCollect" Content="Actualiser ce poste…" MinHeight="32" Margin="0,0,6,0" ToolTip="Prépare une collecte sur ce seul poste, avec confirmation." />
                    <Button x:Name="BtnQueryObjectCopy" Content="Copier le chemin AD" MinHeight="32" />
                  </WrapPanel>
                  <Expander Header="Pourquoi ce résultat ?" IsExpanded="True" Margin="0,0,0,8">
                    <DataGrid x:Name="DgQueryExplanation" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="160" EnableRowVirtualization="True" AutomationProperties.Name="Verdict de chaque condition pour le poste sélectionné">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Condition" Binding="{Binding Condition}" Width="2*" />
                        <DataGridTextColumn Header="Valeur" Binding="{Binding Value}" Width="*" />
                        <DataGridTextColumn Header="Verdict" Binding="{Binding Verdict}" Width="80" />
                        <DataGridTextColumn Header="Disponibilité" Binding="{Binding State}" Width="140" />
                        <DataGridTextColumn Header="Date de la source" Binding="{Binding ObservedAt}" Width="160" />
                      </DataGrid.Columns>
                    </DataGrid>
                  </Expander>
                  <DataGrid x:Name="DgQueryObjectFields" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="280" EnableRowVirtualization="True" AutomationProperties.Name="Données locales de lʼobjet sélectionné">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Information" Binding="{Binding Name}" Width="*" />
                      <DataGridTextColumn Header="Valeur locale" Binding="{Binding Value}" Width="*" />
                      <DataGridTextColumn Header="Disponibilité" Binding="{Binding State}" Width="185" />
                      <DataGridTextColumn Header="Date du relevé" Binding="{Binding ObservedAt}" Width="160" />
                    </DataGrid.Columns>
                  </DataGrid>
                </StackPanel>
              </Expander>
              <DataGrid x:Name="DgFleetMachines" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Postes du périmètre depuis la base locale" MinHeight="100" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="Présence" Width="100" SortMemberPath="PresenceLabel">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal" ToolTip="{Binding PresenceLabel}">
                          <TextBlock Text="{Binding PresenceState}" Foreground="{Binding PresenceBrush}" Margin="4,0,6,0" />
                          <TextBlock Text="{Binding PresenceLabel}" />
                        </StackPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Poste" Binding="{Binding name}" Width="180" />
                  <DataGridTextColumn Header="État" Binding="{Binding StateLabel}" Width="110" />
                  <DataGridTextColumn Header="Système AD" Binding="{Binding OS}" Width="220" />
                  <DataGridTextColumn Header="Version AD" Binding="{Binding Version}" Width="130" />
                  <DataGridTextColumn Header="Connexion AD (j)" Binding="{Binding LogonDays}" Width="120" />
                  <DataGridTextColumn Header="Âge du relevé" Binding="{Binding Observation}" Width="160" />
                  <DataGridTextColumn Header="Valeurs interrogées" Binding="{Binding QueryValues}" Width="260" />
                  <DataGridTextColumn Header="Unité organisationnelle" Binding="{Binding distinguished_name}" Width="*" />
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </TabItem>
          <TabItem x:Name="TabQueryCompose" Header="1. Créer">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="14">
                <TextBlock Text="Choisissez une information, indiquez votre critère, puis consultez un aperçu. Les valeurs non lues restent inconnues." TextWrapping="Wrap" Foreground="{DynamicResource MutedColor}" Margin="0,0,0,8" />
                <TextBlock Text="Quelle information cherchez-vous ?" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBox x:Name="TxtQueryFieldSearch" MaxWidth="430" HorizontalAlignment="Left" MinWidth="240" MinHeight="32" MaxLength="160" Margin="0,0,0,8" ToolTip="Chercher une information par son nom, sa source ou sa classe WMI." AutomationProperties.Name="Rechercher le champ de la requête" />
                <ComboBox x:Name="CmbQueryJunction" Width="270" HorizontalAlignment="Left" SelectedIndex="0" MinHeight="32" Margin="0,0,0,6" AutomationProperties.Name="Combinaison des conditions">
                  <ComboBoxItem Content="Toutes les conditions (ET)" />
                  <ComboBoxItem Content="Au moins une condition (OU)" />
                </ComboBox>
                <WrapPanel Margin="0,0,0,6">
                  <ComboBox x:Name="CmbQueryField" Width="330" MinHeight="32" Margin="0,0,6,0" IsTextSearchEnabled="True" AutomationProperties.Name="Champ à interroger" />
                  <ComboBox x:Name="CmbQueryOperator" Width="190" MinHeight="32" Margin="0,0,6,0" AutomationProperties.Name="Opérateur du filtre" />
                  <TextBox x:Name="TxtQueryValue" Width="150" MaxLength="4096" MinHeight="32" Margin="0,0,6,0" ToolTip="Valeur : texte littéral, nombre avec virgule ou point, Oui ou Non." AutomationProperties.Name="Valeur de la condition" />
                  <ComboBox x:Name="CmbQueryValueChoice" Width="200" MinHeight="32" Margin="0,0,6,0" Visibility="Collapsed" DisplayMemberPath="Name" AutomationProperties.Name="Choisir une valeur de la condition" />
                  <Button x:Name="BtnQueryAddCondition" Content="Ajouter" MinHeight="32" />
                  <Button x:Name="BtnQueryBrowseCatalog" Content="Parcourir le catalogue…" MinHeight="32" Margin="6,0,0,0" ToolTip="Rechercher une information et comprendre sa source avant de préparer une condition." />
                </WrapPanel>
                <TextBlock x:Name="LblQueryValueConversion" TextWrapping="Wrap" Margin="0,0,0,2" AutomationProperties.Name="Contrôle de la valeur saisie" AutomationProperties.LiveSetting="Polite" />
                <TextBlock x:Name="LblQueryFieldHelp" TextWrapping="Wrap" Foreground="{DynamicResource MutedColor}" Margin="0,4,0,14" />
                <TextBlock Text="Vos critères" FontWeight="SemiBold" Margin="0,0,0,6" />
                <DataGrid x:Name="DgQueryConditions" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="170" MinHeight="65" SelectionMode="Single" AutomationProperties.Name="Conditions de la requête">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Champ" Binding="{Binding FieldLabel}" Width="*" />
                    <DataGridTextColumn Header="Condition" Binding="{Binding OperatorLabel}" Width="190" />
                    <DataGridTextColumn Header="Valeur" Binding="{Binding Value}" Width="220" />
                  </DataGrid.Columns>
                </DataGrid>
                <WrapPanel Margin="0,10,0,18">
                  <Button x:Name="BtnQueryRemoveCondition" Content="Retirer la condition" MinHeight="32" Margin="0,0,6,0" />
                  <Button x:Name="BtnQueryCollect" Content="Collecter les données requises…" MinHeight="32" Margin="0,0,6,0" ToolTip="Prépare une collecte confirmée sur les postes actifs du périmètre. Ne lance jamais toutes les sondes du catalogue." />
                </WrapPanel>
                <Expander x:Name="ExpQueryCollectionPlan" Header="Plan de collecte des informations manquantes" Visibility="Collapsed" Margin="0,-8,0,14">
                  <TextBlock x:Name="LblQueryCollectionPlan" TextWrapping="Wrap" Margin="0,6,0,6" AutomationProperties.Name="Plan de collecte et coût avant confirmation" AutomationProperties.LiveSetting="Polite" />
                </Expander>
                <Button x:Name="BtnQueryCoverage" Content="Vérifier les informations disponibles" MinHeight="32" Margin="0,0,8,0" ToolTip="Compter les champs disponibles, expirés ou non lus avant dʼappliquer les conditions. Aucun accès réseau." />
                    <Button x:Name="BtnQueryPreview" Content="Voir l’aperçu local →" Style="{DynamicResource RunButton}" MinHeight="36" HorizontalAlignment="Left" Margin="0,2,0,12" />
                <Expander x:Name="ExpQueryAdvanced" Header="Conditions avancées et paramètres" Margin="0,6,0,6">
                  <StackPanel Margin="0,8,0,8">
                    <TextBlock Text="Les groupes ci-dessous s’ajoutent aux critères simples avec ET. Une collection vérifie les propriétés d’une même instance (disque, service…). Une collecte partielle reste inconnue si aucun témoin ne suffit à conclure." TextWrapping="Wrap" Margin="0,0,0,8" />
                    <ListBox x:Name="LstQueryExpression" DisplayMemberPath="Label" Height="160" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Arbre des groupes et conditions" />
                    <WrapPanel Margin="0,6,0,6">
                      <Button x:Name="BtnQueryGroupAll" Content="+ Groupe ET" Margin="0,0,6,0" />
                      <Button x:Name="BtnQueryGroupAny" Content="+ Groupe OU" Margin="0,0,6,0" />
                      <Button x:Name="BtnQueryGroupNot" Content="+ Groupe NON" Margin="0,0,6,0" />
                      <Button x:Name="BtnQueryTreeCondition" Content="+ Critère choisi ci-dessus" Margin="0,0,6,0" />
                      <Button x:Name="BtnQueryTreeRemove" Content="Retirer" Margin="0,0,6,0" />
                      <Button x:Name="BtnQueryTreeUp" Content="↑" AutomationProperties.Name="Monter la condition" Margin="0,0,6,0" />
                      <Button x:Name="BtnQueryTreeDown" Content="↓" AutomationProperties.Name="Descendre la condition" Margin="0,0,6,0" />
                      <Button x:Name="BtnQueryTreeClear" Content="Effacer les groupes" />
                    </WrapPanel>
                    <TextBlock Text="Condition sur une collection" FontWeight="SemiBold" Margin="0,8,0,4" />
                    <WrapPanel Margin="0,0,0,6">
                      <ComboBox x:Name="CmbQueryCollectionProbe" Width="300" MinHeight="32" DisplayMemberPath="Name" AutomationProperties.Name="Collection de la sonde" Margin="0,0,6,0" />
                      <ComboBox x:Name="CmbQueryQuantifier" Width="190" MinHeight="32" SelectedIndex="0" Margin="0,0,6,0">
                        <ComboBoxItem Content="Au moins une instance" Tag="Any" />
                        <ComboBoxItem Content="Toutes les instances" Tag="All" />
                        <ComboBoxItem Content="Aucune instance" Tag="None" />
                      </ComboBox>
                      <Button x:Name="BtnQueryCollectionAdd" Content="+ Collection" MinHeight="32" />
                    </WrapPanel>
                    <WrapPanel Margin="0,0,0,10">
                      <ComboBox x:Name="CmbQueryInstanceField" Width="300" MinHeight="32" DisplayMemberPath="Name" AutomationProperties.Name="Propriété d’une instance" Margin="0,0,6,0" />
                      <ComboBox x:Name="CmbQueryInstanceOperator" Width="180" MinHeight="32" DisplayMemberPath="Name" Margin="0,0,6,0" />
                      <TextBox x:Name="TxtQueryInstanceValue" Width="140" MaxLength="4096" MinHeight="32" AutomationProperties.Name="Valeur de la propriété d’instance" Margin="0,0,6,0" />
                      <Button x:Name="BtnQueryInstanceAdd" Content="+ Critère d’instance" MinHeight="32" />
                    </WrapPanel>
                    <TextBlock Text="Paramètres réutilisables" FontWeight="SemiBold" Margin="0,8,0,4" />
                    <TextBlock Text="Sélectionnez un critère simple puis donnez un nom à son paramètre. La valeur peut ensuite être changée sans recréer la requête." TextWrapping="Wrap" Margin="0,0,0,6" />
                    <WrapPanel Margin="0,0,0,6">
                      <TextBox x:Name="TxtQueryParameterName" Width="220" MaxLength="64" MinHeight="32" ToolTip="Nom technique : lettre puis lettres, chiffres ou tiret bas." AutomationProperties.Name="Nom du paramètre" Margin="0,0,6,0" />
                      <Button x:Name="BtnQueryParameterAdd" Content="Paramétrer le critère sélectionné" Margin="0,0,6,0" />
                      <Button x:Name="BtnQueryParameterFreeze" Content="Fixer les valeurs actuelles" />
                    </WrapPanel>
                    <DataGrid x:Name="DgQueryParameters" AutoGenerateColumns="False" CanUserAddRows="False" MaxHeight="180" AutomationProperties.Name="Valeurs des paramètres">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Paramètre" Binding="{Binding Name}" IsReadOnly="True" Width="*" />
                        <DataGridTextColumn Header="Information" Binding="{Binding FieldName}" IsReadOnly="True" Width="2*" />
                        <DataGridTextColumn Header="Valeur" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                      </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Margin="0,10,0,0">
                      <TextBlock Text="Écart maximal entre les dates sources (heures)" VerticalAlignment="Center" Margin="0,0,8,0" />
                      <TextBox x:Name="TxtQueryCoherenceHours" Width="100" MaxLength="12" MinHeight="32" AutomationProperties.Name="Fenêtre de cohérence temporelle en heures" />
                    </WrapPanel>
                    <TextBlock Text="Facultatif : laisser vide pour accepter des dates différentes. Sinon, une date absente ou un écart trop grand produit Inconnu. La date correspond au relevé de chaque information." TextWrapping="Wrap" Foreground="{DynamicResource MutedColor}" Margin="0,6,0,0" />
                  </StackPanel>
                </Expander>
                <Expander Header="Réglages de collecte" Margin="0,6,0,6">
                  <WrapPanel Margin="0,6,0,6">
                    <TextBlock Text="Postes en parallèle" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="CmbCollectionConcurrency" Width="80" MinHeight="32" Margin="0,0,18,0" AutomationProperties.Name="Nombre maximal de postes collectés en parallèle" />
                    <TextBlock Text="Réutiliser les mesures fraîches" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="CmbCollectionCache" Width="210" MinHeight="32" AutomationProperties.Name="Durée de réutilisation des mesures" ToolTip="Les sondes volatiles sont relues après une minute, lʼinventaire après cinq minutes. Forcer relit toutes les mesures demandées." />
                  </WrapPanel>
                </Expander>
                <Expander x:Name="ExpQueryCoverage" Header="Couverture et dates des informations" Margin="0,10,0,0">
                  <StackPanel>
                    <TextBlock x:Name="LblQueryCoverage" Text="Vérifiez la couverture des informations avant lʼaperçu." TextWrapping="Wrap" Margin="0,4,0,8" />
                    <DataGrid x:Name="DgQueryCoverage" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" MaxHeight="190" EnableRowVirtualization="True">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Information" Binding="{Binding Name}" Width="2*" />
                        <DataGridTextColumn Header="Disponible" Binding="{Binding Available}" Width="85" />
                        <DataGridTextColumn Header="Expirée" Binding="{Binding Expired}" Width="75" />
                        <DataGridTextColumn Header="Erreur" Binding="{Binding Error}" Width="70" />
                        <DataGridTextColumn Header="Incomplète" Binding="{Binding Partial}" Width="85" />
                        <DataGridTextColumn Header="Non lue" Binding="{Binding Unread}" Width="75" />
                      </DataGrid.Columns>
                    </DataGrid>
                  </StackPanel>
                </Expander>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem x:Name="TabQueryWmi" Header="WMI avancé">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="14">
              <TextBlock Text="Explorer le schéma puis préparer un SELECT sur le poste dont la fiche est ouverte. Chaque lecture est explicite, utilise le compte distant configuré et conserve ses résultats dans la base avant affichage." TextWrapping="Wrap" Margin="0,0,0,10" />
              <WrapPanel Margin="0,0,0,8">
                <TextBox x:Name="TxtQueryWmiNamespace" Text="root\cimv2" Width="200" MinHeight="32" AutomationProperties.Name="Espace de noms WMI" Margin="0,0,6,0" />
                <TextBox x:Name="TxtQueryWmiClass" Text="Win32_OperatingSystem" Width="260" MinHeight="32" AutomationProperties.Name="Classe WMI" Margin="0,0,6,0" />
                <Button x:Name="BtnQuerySchemaRead" Content="Lire le schéma sur le poste…" MinHeight="32" />
              </WrapPanel>
              <DataGrid x:Name="DgQuerySchema" AutoGenerateColumns="False" CanUserAddRows="False" Height="170" EnableRowVirtualization="True" AutomationProperties.Name="Propriétés du schéma WMI enregistré">
                <DataGrid.Columns><DataGridCheckBoxColumn Header="Inclure" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="70" /><DataGridTextColumn Header="Propriété" Binding="{Binding Property}" IsReadOnly="True" Width="*" /><DataGridTextColumn Header="Type CIM" Binding="{Binding Type}" IsReadOnly="True" Width="150" /><DataGridCheckBoxColumn Header="Clé" Binding="{Binding IsKey}" IsReadOnly="True" Width="70" /></DataGrid.Columns>
              </DataGrid>
              <Button x:Name="BtnQueryWqlBuild" Content="Préparer le SELECT avec les propriétés cochées" HorizontalAlignment="Left" MinHeight="32" Margin="0,6,0,8" />
              <TextBox x:Name="TxtQueryWql" Text="SELECT Caption, Version FROM Win32_OperatingSystem" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="8192" Height="95" AutomationProperties.Name="Instruction WQL SELECT" />
              <TextBlock Text="Propriétés explicites ; conditions =, &lt;&gt;, &lt;, &gt;, LIKE, IS NULL, ET/OU avec AND/OR/NOT. Pas de méthode ni de fournisseur MSI. Une recette n’effectue aucune lecture distante automatiquement." TextWrapping="Wrap" Foreground="{DynamicResource MutedColor}" Margin="0,6,0,8" />
              <WrapPanel Margin="0,0,0,8"><TextBlock Text="Limite d’instances" VerticalAlignment="Center" Margin="0,0,8,0" /><TextBox x:Name="TxtQueryWmiLimit" Text="100" MaxLength="4" Width="75" MinHeight="32" Margin="0,0,8,0" /><Button x:Name="BtnQueryWqlRun" Content="Exécuter sur le poste…" MinHeight="32" Margin="0,0,8,0" /><Button x:Name="BtnQueryWqlRecipe" Content="Préparer une recette locale" IsEnabled="False" MinHeight="32" /></WrapPanel>
              <TextBlock x:Name="LblQueryWmiStatus" Text="Aucune lecture WMI avancée lancée." TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite" />
              <DataGrid x:Name="DgQueryWmiRows" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="220" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Instances WMI relues dans la base"><DataGrid.Columns><DataGridTextColumn Header="Identité du fournisseur" Binding="{Binding Id}" Width="250" /><DataGridTextColumn Header="Valeurs" Binding="{Binding ValueText}" Width="*" /><DataGridTextColumn Header="Couverture" Binding="{Binding Completeness}" Width="200" /></DataGrid.Columns></DataGrid>
              <Expander Header="Associations de l’instance sélectionnée" Margin="0,8,0,0"><StackPanel><TextBlock Text="Choisissez une instance enregistrée, indiquez une classe d’association et une classe résultat. La relation est lue sur ce seul poste ; aucune méthode n’est exécutée." TextWrapping="Wrap" Margin="0,6,0,6" /><WrapPanel><TextBox x:Name="TxtQueryAssociationClass" Width="260" MinHeight="32" AutomationProperties.Name="Classe d’association" Margin="0,0,6,0" /><TextBox x:Name="TxtQueryAssociationResult" Width="260" MinHeight="32" AutomationProperties.Name="Classe résultat de l’association" Margin="0,0,6,0" /><Button x:Name="BtnQueryAssociations" Content="Lire cette relation…" MinHeight="32" /></WrapPanel></StackPanel></Expander>
            </StackPanel></ScrollViewer>
          </TabItem>
          <TabItem x:Name="TabQueryPublish" Header="3. Enregistrer">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="14">
                <Expander Header="Partager ou importer des recettes" Margin="0,0,0,12"><StackPanel>
                  <WrapPanel Margin="0,8,0,8"><Button x:Name="BtnQueryPackExport" Content="Exporter ma bibliothèque (JSON)…" MinHeight="32" Margin="0,0,6,0" /><Button x:Name="BtnQueryScriptExport" Content="Exporter cette requête (PowerShell)…" MinHeight="32" Margin="0,0,6,0" /><Button x:Name="BtnQueryPackImport" Content="Examiner un pack…" MinHeight="32" /></WrapPanel>
                  <TextBlock x:Name="LblQueryImportStatus" Text="L’import affiche les différences avant toute écriture. Les recettes ne lancent jamais de collecte implicitement." TextWrapping="Wrap" Margin="0,0,0,8" />
                  <DataGrid x:Name="DgQueryImport" AutoGenerateColumns="False" CanUserAddRows="False" MaxHeight="220" EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling"><DataGrid.Columns>
                    <DataGridTextColumn Header="Requête" Binding="{Binding Name}" IsReadOnly="True" Width="*" /><DataGridTextColumn Header="Différence" Binding="{Binding Status}" IsReadOnly="True" Width="150" />
                    <DataGridTemplateColumn Header="Choix" Width="230"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding AllowedActions}" SelectedItem="{Binding Action, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  </DataGrid.Columns></DataGrid>
                  <WrapPanel Margin="0,8,0,0"><Button x:Name="BtnQueryImportNew" Content="Choisir les nouvelles" Margin="0,0,6,0" /><Button x:Name="BtnQueryImportApply" Content="Appliquer mes choix…" Margin="0,0,6,0" /><Button x:Name="BtnQueryImportRollback" Content="Restaurer avant cet import…" /></WrapPanel>
                </StackPanel></Expander>
                <TextBlock x:Name="LblQueryPublishSummary" Text="Consultez l’aperçu pour vérifier les postes correspondants et les informations inconnues." TextWrapping="Wrap" Foreground="{DynamicResource MutedColor}" Margin="0,0,0,12" />
                <TextBlock Text="Gardez cette requête à portée de main" FontWeight="SemiBold" FontSize="15" Margin="0,2,0,10" />
                <WrapPanel Margin="0,0,0,6">
                  <TextBox x:Name="TxtFleetQueryName" Width="330" MaxLength="120" MinHeight="32" Margin="0,0,6,0" AutomationProperties.Name="Nom de la requête" />
                  <Button x:Name="BtnQuerySave" Content="Enregistrer" MinHeight="32" Margin="0,0,6,0" />
                  <Button x:Name="BtnQueryWidget" Content="Créer une sonde dashboard" MinHeight="32" ToolTip="Enregistre la requête et ajoute sa visualisation au tableau de bord choisi. La petite icône près du crayon ouvre les postes correspondants dans lʼatelier." />
                  <Button x:Name="BtnQueryDelete" Content="Archiver la requête" MinHeight="32" ToolTip="Archive cette requête dans la base après vérification de ses widgets liés. Les données collectées sont conservées." Margin="6,0,0,0" />
                </WrapPanel>
                <WrapPanel Margin="0,0,0,6">
                  <TextBlock Text="Visualisation" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <ComboBox x:Name="CmbQueryGroupField" Width="330" MinHeight="32" AutomationProperties.Name="Champ de répartition du widget" ToolTip="Compteur, ou répartition des postes correspondants par une information. Le graphique se personnalise ensuite dans le dashboard." />
                </WrapPanel>
                <WrapPanel Margin="0,4,0,6">
                  <TextBlock Text="Destination de la sonde" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <ComboBox x:Name="CmbQueryWidgetDestination" Width="245" MinHeight="32" SelectedIndex="0" Margin="0,0,8,0" AutomationProperties.Name="Tableau de bord de destination">
                    <ComboBoxItem Content="Tableau de bord général" Tag="Fleet" />
                    <ComboBoxItem Content="Tableau de bord du poste" Tag="Computer" />
                  </ComboBox>
                  <ComboBox x:Name="CmbQueryWidgetVisual" Width="160" MinHeight="32" SelectedIndex="0" AutomationProperties.Name="Présentation de la sonde">
                    <ComboBoxItem Content="Indicateur" Tag="Kpi" />
                    <ComboBoxItem Content="Texte" Tag="Text" />
                    <ComboBoxItem Content="Barres" Tag="Bar" />
                    <ComboBoxItem Content="Camembert" Tag="Pie" />
                    <ComboBoxItem Content="Colonnes" Tag="Column" />
                  </ComboBox>
                </WrapPanel>
                <TextBlock Text="Lʼatelier liste les postes de lʼOU. Un widget du tableau de bord Poste applique cette requête au poste sélectionné." TextWrapping="Wrap" Foreground="{DynamicResource MutedColor}" Margin="0,2,0,8" />
                <Button x:Name="BtnQueryPreviewComputer" Content="Tester sur le poste sélectionné" MinHeight="32" HorizontalAlignment="Left" ToolTip="Évalue la requête sur les données locales déjà enregistrées du poste sélectionné." />
                <TextBlock x:Name="LblQueryComputerPreview" TextWrapping="Wrap" Foreground="{DynamicResource MutedColor}" Margin="0,4,0,8" />
                <WrapPanel Margin="0,10,0,6">
                  <Button x:Name="BtnQueryApplySearch" Content="Appliquer aux résultats de Recherche" MinHeight="32" ToolTip="Filtre les lignes déjà présentes dans Recherche. Aucune nouvelle recherche AD." />
                  <Button x:Name="BtnQueryRevise" Content="Modifier les critères" MinHeight="32" Margin="8,0,0,0" />
                </WrapPanel>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem x:Name="TabQueryLibrary" Header="Bibliothèque">
            <DockPanel Margin="10">
              <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Requêtes prêtes à utiliser" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="Choisissez un modèle, adaptez ses conditions, puis utilisez-le dans Recherche ou dans un tableau de bord général ou Poste." TextWrapping="Wrap" Foreground="{DynamicResource MutedColor}" Margin="0,4,0,10" />
                <WrapPanel Margin="0,0,0,8">
                  <TextBlock Text="Rechercher" VerticalAlignment="Center" Margin="0,0,8,6" />
                  <TextBox x:Name="TxtQueryLibrarySearch" Width="280" MinHeight="32" MaxLength="256" Margin="0,0,8,6" ToolTip="Rechercher par nom, usage ou catégorie. Les accents et la casse sont ignorés." AutomationProperties.Name="Rechercher une requête prête à utiliser" />
                  <ComboBox x:Name="CmbQueryLibraryCategory" Width="230" MinHeight="32" Margin="0,0,8,6" AutomationProperties.Name="Catégorie de requêtes" />
                  <ComboBox x:Name="CmbQueryLibrarySource" Width="190" MinHeight="32" Margin="0,0,8,6" SelectedIndex="0" AutomationProperties.Name="Origine des requêtes">
                    <ComboBoxItem Content="Toutes les requêtes" Tag="" />
                    <ComboBoxItem Content="Modèles livrés" Tag="Template" />
                    <ComboBoxItem Content="Mes requêtes" Tag="Saved" />
                  </ComboBox>
                  <TextBlock x:Name="LblQueryLibraryCount" VerticalAlignment="Center" Foreground="{DynamicResource MutedColor}" />
                </WrapPanel>
              </StackPanel>
              <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <WrapPanel Margin="0,0,0,8"><Button x:Name="BtnQueryLibraryPrevious" Content="Page précédente" IsEnabled="False" MinHeight="30" Margin="0,0,6,0" /><Button x:Name="BtnQueryLibraryNext" Content="Page suivante" IsEnabled="False" MinHeight="30" /></WrapPanel>
                <TextBlock x:Name="LblQueryLibraryDescription" Text="Sélectionnez une requête pour consulter son usage." TextWrapping="Wrap" MaxHeight="76" />
                <TextBlock x:Name="LblQueryLibraryCollection" TextWrapping="Wrap" Foreground="{DynamicResource MutedColor}" Margin="0,5,0,8" />
                <Button x:Name="BtnQueryLibraryUse" Content="Utiliser cette requête" IsEnabled="False" MinHeight="32" HorizontalAlignment="Left" AutomationProperties.Name="Charger la requête sélectionnée dans le compositeur" />
              </StackPanel>
              <DataGrid x:Name="DgQueryLibrary" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" MinHeight="100" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Bibliothèque de requêtes pour le parc et les postes">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Requête" Binding="{Binding Name}" Width="2*" />
                  <DataGridTextColumn Header="Catégorie" Binding="{Binding Category}" Width="190" />
                  <DataGridTextColumn Header="Informations nécessaires" Binding="{Binding DataSource}" Width="210" />
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </TabItem>
          <TabItem x:Name="TabQueryCatalog" Header="Informations">
            <Grid Margin="12">
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
              <TextBlock Text="Découvrez les informations prises en charge par Domenia. Ce catalogue décrit les capacités disponibles ; leur lecture dépend du poste, du fournisseur Windows et des droits." TextWrapping="Wrap" Foreground="{DynamicResource MutedColor}" Margin="0,0,0,8" />
              <StackPanel Grid.Row="1">
                <WrapPanel>
                  <TextBox x:Name="TxtQueryCatalogSearch" Width="280" MinHeight="32" MaxLength="256" Margin="0,0,8,6" ToolTip="Chercher un nom, une classe WMI, une propriété ou un usage. Les accents et la casse sont ignorés." AutomationProperties.Name="Rechercher une information dans le catalogue" />
                  <ComboBox x:Name="CmbQueryCatalogSource" Width="170" MinHeight="32" Margin="0,0,8,6" AutomationProperties.Name="Filtrer le catalogue par source" />
                  <ComboBox x:Name="CmbQueryCatalogCategory" Width="215" MinHeight="32" Margin="0,0,0,6" AutomationProperties.Name="Filtrer le catalogue par catégorie" />
                </WrapPanel>
                <TextBlock x:Name="LblQueryCatalogCount" TextWrapping="Wrap" Foreground="{DynamicResource MutedColor}" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite" />
              </StackPanel>
              <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <DataGrid x:Name="DgQueryCatalog" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Informations disponibles pour les requêtes">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Information" Binding="{Binding Name}" Width="*" MinWidth="200" />
                    <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="115" />
                    <DataGridTextColumn Header="Valeur" Binding="{Binding Unit}" Width="90" />
                  </DataGrid.Columns>
                </DataGrid>
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Margin="2,0,10,0">
                    <TextBlock x:Name="LblQueryCatalogTitle" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <StackPanel x:Name="PnlQueryCatalogDetail">
                      <TextBlock x:Name="LblQueryCatalogDescription" TextWrapping="Wrap" Margin="0,0,0,8" />
                      <TextBlock x:Name="LblQueryCatalogValue" TextWrapping="Wrap" Margin="0,0,0,12" />
                      <TextBlock Text="Comment obtenir cette information" FontWeight="SemiBold" Margin="0,0,0,4" />
                      <TextBlock x:Name="LblQueryCatalogCollection" TextWrapping="Wrap" Margin="0,0,0,8" />
                      <TextBlock x:Name="LblQueryCatalogAvailability" TextWrapping="Wrap" Foreground="{DynamicResource MutedColor}" Margin="0,0,0,12" />
                      <Expander Header="Détails techniques" IsExpanded="False" Margin="0,0,0,12">
                        <TextBlock x:Name="LblQueryCatalogTechnical" TextWrapping="Wrap" Margin="0,6,0,0" />
                      </Expander>
                    </StackPanel>
                    <Button x:Name="BtnQueryCatalogUse" Content="Utiliser cette information" MinHeight="34" HorizontalAlignment="Left" IsEnabled="False" ToolTip="Prépare le champ dans Composer la requête. Vous choisissez ensuite la condition et cliquez sur Ajouter." />
                  </StackPanel>
                </ScrollViewer>
              </Grid>
            </Grid>
          </TabItem>
        </TabControl>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
