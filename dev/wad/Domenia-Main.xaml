                            </StackPanel>
                            <Button x:Name="BtnAccountAdCorrect" Content="Corriger le mot de passe" Margin="0,24,8,0" AutomationProperties.Name="Corriger le mot de passe"/>
                          </WrapPanel>
                        </StackPanel>
                      </Border>
                      <!-- UI-27 / point 42: accounts really used now, per resource, with their origin and protection state, and the accounts
                           kept in memory with their remaining time. -->
