<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Offline only: the VM has no Internet. Every package is vendored with its SHA-256 (vendor/nuget/SHA256SUMS). -->
  <packageSources>
    <clear />
    <add key="vendor" value="vendor/nuget" />
    <add key="cache" value="C:\DomeniaDev\cache\nuget" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="vendor">
      <package pattern="System.*" />
      <package pattern="Microsoft.Web.WebView2" />
    </packageSource>
    <packageSource key="cache">
      <package pattern="Microsoft.NETCore.App.*" />
      <package pattern="Microsoft.WindowsDesktop.App.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
