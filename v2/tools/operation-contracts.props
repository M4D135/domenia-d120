  <Target Name="VerifyDomeniaOperationContracts" BeforeTargets="CoreCompile">
    <ItemGroup>
      <DomeniaCurrentSource Include="$(MSBuildThisFileDirectory)../src/Domenia.Core/**/*.cs;$(MSBuildThisFileDirectory)../src/Domenia.Core/**/*.csproj" Exclude="$(MSBuildThisFileDirectory)../src/Domenia.Core/**/bin/**;$(MSBuildThisFileDirectory)../src/Domenia.Core/**/obj/**" />
      <DomeniaCurrentSource Include="$(MSBuildThisFileDirectory)../src/Domenia.Store/**/*.cs;$(MSBuildThisFileDirectory)../src/Domenia.Store/**/*.csproj" Exclude="$(MSBuildThisFileDirectory)../src/Domenia.Store/**/bin/**;$(MSBuildThisFileDirectory)../src/Domenia.Store/**/obj/**" />
      <DomeniaCurrentSource Include="$(MSBuildThisFileDirectory)../src/Domenia.Ad/**/*.cs;$(MSBuildThisFileDirectory)../src/Domenia.Ad/**/*.csproj" Exclude="$(MSBuildThisFileDirectory)../src/Domenia.Ad/**/bin/**;$(MSBuildThisFileDirectory)../src/Domenia.Ad/**/obj/**" />
      <DomeniaCurrentSource Include="$(MSBuildThisFileDirectory)../src/Domenia.Bridge/**/*.cs;$(MSBuildThisFileDirectory)../src/Domenia.Bridge/**/*.csproj" Exclude="$(MSBuildThisFileDirectory)../src/Domenia.Bridge/**/bin/**;$(MSBuildThisFileDirectory)../src/Domenia.Bridge/**/obj/**" />
      <DomeniaCurrentSource Include="$(MSBuildThisFileDirectory)../src/Domenia.Inventory/**/*.cs;$(MSBuildThisFileDirectory)../src/Domenia.Inventory/**/*.csproj" Exclude="$(MSBuildThisFileDirectory)../src/Domenia.Inventory/**/bin/**;$(MSBuildThisFileDirectory)../src/Domenia.Inventory/**/obj/**" />
      <DomeniaCurrentSource Include="$(MSBuildThisFileDirectory)../src/Domenia.App/**/*.cs;$(MSBuildThisFileDirectory)../src/Domenia.App/**/*.csproj" Exclude="$(MSBuildThisFileDirectory)../src/Domenia.App/**/bin/**;$(MSBuildThisFileDirectory)../src/Domenia.App/**/obj/**" />
      <DomeniaCurrentSource Include="$(MSBuildThisFileDirectory)../src/Domenia.Engine/**/*.cs;$(MSBuildThisFileDirectory)../src/Domenia.Engine/**/*.csproj" Exclude="$(MSBuildThisFileDirectory)../src/Domenia.Engine/**/bin/**;$(MSBuildThisFileDirectory)../src/Domenia.Engine/**/obj/**" />
      <DomeniaCurrentSource Include="$(MSBuildThisFileDirectory)../src/Domenia.Simulation/**/*.cs;$(MSBuildThisFileDirectory)../src/Domenia.Simulation/**/*.csproj" Exclude="$(MSBuildThisFileDirectory)../src/Domenia.Simulation/**/bin/**;$(MSBuildThisFileDirectory)../src/Domenia.Simulation/**/obj/**" />
    </ItemGroup>
    <Error Condition="'@(DomeniaCurrentSource->Count())' != '1063'" Text="Fermeture des sources modifiée : ajout ou retrait non revu. Mettre à jour explicitement le registre avant compilation." />
    <GetFileHash Files="@(DomeniaPinnedSource)" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Items" ItemName="DomeniaMeasuredSource" />
    </GetFileHash>
    <Error Condition="'%(DomeniaMeasuredSource.FileHash)' != '%(DomeniaMeasuredSource.ExpectedSha256)'" Text="Corps non épinglé : %(DomeniaMeasuredSource.Identity). Revue et mise à jour explicite du registre requises ; aucune compilation autorisée." />
  </Target>
</Project>
