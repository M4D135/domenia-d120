+function Invalidate-AdccSearchResults {
+    # Toute modification de perimetre invalide aussi les retours deja en vol.
+    $script:GlobalSearchGeneration = [int]$script:GlobalSearchGeneration + 1
+    try { if ($null -ne $script:LiveSearchTimer) { $script:LiveSearchTimer.Stop() } } catch { }
+    if ($null -ne $script:AsyncJobs) {
+        foreach ($id in @($script:AsyncJobs.Keys)) {
+            $job = $script:AsyncJobs[$id]
+            if ($null -ne $job -and [string]$job.ReplaceKey -in @('global','branch') -and -not [bool]$job.IsWrite) {
+                Request-UiTaskStop -Id $id -Silent -Force -Superseded
+            }
+        }
+    }
+    Stop-AdccSelectionOpenTimer
+    $script:PendingObjectSelection = $null
+    $script:BranchObjects = @()
+    $script:BranchCountLabel = 'Filtres modifies : recherche a effectuer'
+    $wasSuppressed = [bool]$script:SuppressGridSelectionEvents
+    $script:SuppressGridSelectionEvents = $true
+    try { [void](Set-AdccItemsSource -Name 'DgObjects' -Rows @()) }
+    finally { $script:SuppressGridSelectionEvents = $wasSuppressed }
+    [void](Set-AdccControlText -Name 'LblBranchCount' -Text $script:BranchCountLabel)
+}
+
+function Test-AdccSearchStateCurrent {
+    param($State)
+    if ($null -eq $State) { return $false }
+    if ([int]$State.Generation -ne [int]$script:GlobalSearchGeneration) { return $false }
+    $scope = Get-AdccSearchScope
+    if (-not [string]::Equals([string]$State.BaseDn,[string]$scope.BaseDn,[StringComparison]::OrdinalIgnoreCase)) { return $false }
+    if ([string]$State.Scope -ne [string]$scope.Scope) { return $false }
+    if ([string]$State.TypeFilter -ne [string](Get-GlobalSelectedTypeFilter)) { return $false }
+    $box = Get-AdccControl -Name 'TxtGlobalSearch'
+    if ($null -ne $box -and ([string]$box.Text).Trim() -ne [string]$State.Search) { return $false }
+    return $true
+}
+
+function Invoke-AdccSearchFilterChanged {
+    if ($script:RestoringSettings -or $script:SuppressBranchAutoLoad -or -not $script:Conn.Connected) { return }
+    if ([string]::IsNullOrWhiteSpace([string]$script:SelectedBranchDn)) { return }
+    Invalidate-AdccSearchResults
+    Update-AdccSearchScopeUi
+    Select-AdccWorkspace -Workspace 'WsSearch'
+    Invoke-GlobalSearch -AllowEmpty -SilentError
+}
+
+function Reset-AdccSearchScope {
+    param([switch]$NoSearch)
+    if ([string]::IsNullOrWhiteSpace([string]$script:Conn.BaseDn)) { return }
+    $previousSuppression = [bool]$script:SuppressBranchAutoLoad
+    $script:SuppressBranchAutoLoad = $true
+    try {
+        $script:SelectedBranchDn = [string]$script:Conn.BaseDn
+        $check = Get-AdccControl -Name 'ChkSubtree'
+        if ($null -ne $check) { $check.IsChecked = $true }
+        $tree = Get-AdccControl -Name 'TvDirectory'
+        if ($null -ne $tree -and $tree.Items.Count -gt 0) { $tree.Items[0].IsSelected = $true }
+        Update-AdccSearchScopeUi
+    }
+    finally { $script:SuppressBranchAutoLoad = $previousSuppression }
+    if (-not $NoSearch) { Invoke-AdccSearchFilterChanged }
 }
 
