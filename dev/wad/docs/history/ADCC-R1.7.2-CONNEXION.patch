+    function Protect-AuthDiagnosticText {
+        param([AllowNull()][string]$Text,[AllowNull()][string]$Secret='')
+        $safe=[string]$Text
+        if (-not [string]::IsNullOrEmpty($Secret)) { $safe=$safe.Replace($Secret,'[SECRET MASQUE]') }
+        # No invocation source / request / credential serialization. Bound diagnostic size.
+        if ($safe.Length -gt 4096) { $safe=$safe.Substring(0,4096)+' [tronque]' }
+        return $safe
+    }
