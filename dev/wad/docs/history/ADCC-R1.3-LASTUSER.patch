+function Get-AdccRunningComputerUserProbe {
+    param([string]$Computer)
+    $normalized = Normalize-LinkComputer $Computer
+    if ([string]::IsNullOrWhiteSpace($normalized)) { return $null }
+    foreach ($taskId in @($script:AsyncJobs.Keys)) {
+        $job = $script:AsyncJobs[$taskId]
+        if ($null -eq $job -or [string]$job.OperationId -ne 'ComputerLastUser') { continue }
+        if ([bool]$job.CancelRequested -or [bool]$job.Superseded) { continue }
+        if ([long]$job.SessionEpoch -ne [long]$script:SessionEpoch) { continue }
+        $target = Normalize-LinkComputer ([string]$job.CallbackState.Computer)
+        if ($target -ieq $normalized) { return $job }
+    }
+    return $null
+}
+
+function Clear-AdccComputerUserProbeState {
+    param([string]$ProbeId,[string]$Computer)
+    # Un ancien arret ne doit pas effacer l identifiant d une nouvelle detection.
+    if ([string]::IsNullOrWhiteSpace($ProbeId) -or [string]$script:ActiveLinkProbeId -ne $ProbeId) { return }
+    $normalized = Normalize-LinkComputer $Computer
+    if ([string]$script:ActiveLinkProbeComputer -ine $normalized) { return }
+    $script:ActiveLinkProbeId = ''
+    $script:ActiveLinkProbeComputer = ''
+    try { if ($script:LinkProbeDone.ContainsKey($normalized)) { [void]$script:LinkProbeDone.Remove($normalized) } } catch { }
+}
+
+function Receive-AdccComputerUserProbeProgress {
+    param($Job)
+    if ($null -eq $Job -or [string]$Job.OperationId -ne 'ComputerLastUser') { return }
+    if ([long]$Job.SessionEpoch -ne [long]$script:SessionEpoch) { return }
+    $queue = $null
+    try { $queue = $Job.CallbackState.Progress } catch { }
+    if ($null -eq $queue) { return }
+    $computer = Normalize-LinkComputer ([string]$Job.CallbackState.Computer)
+    $probeId = [string]$Job.CallbackState.ProbeId
+    # File thread-safe, bornee par le nombre fixe de methodes et le budget du resolver.
+    for ($i=0; $i -lt 32; $i++) {
+        $item = $null
+        if (-not $queue.TryDequeue([ref]$item)) { break }
+        if ($null -eq $item) { continue }
+        $detail = ([regex]::Replace(([string]$item.Detail),'\s+',' ')).Trim()
+        if ($detail.Length -gt 1200) { $detail = $detail.Substring(0,1200)+' [...]' }
+        $level = if ([string]$item.Status -in @('KO','VALIDATION AD KO')) { 'WARN' } else { 'INFO' }
+        Write-AppLog ("Association {0} [probe={1}] | {2} [{3}] | {4}" -f $computer,$probeId,[string]$item.Method,[string]$item.Status,$detail) $level
+        if ([string]$item.Status -eq 'EN COURS' -and [string]$script:ActiveLinkProbeId -eq $probeId -and
+            (Get-CurrentSelectedComputerName) -ieq $computer) {
+            [void](Set-AdccControlText -Name 'LblLinkProbeStatus' -Text ("Detection de {0} : {1}..." -f $computer,[string]$item.Method))
+        }
+    }
+}
+
+function Stop-AdccComputerUserProbeUi {
+    param($Job,[string]$Reason)
+    if ($null -eq $Job -or [string]$Job.OperationId -ne 'ComputerLastUser') { return }
+    $computer = Normalize-LinkComputer ([string]$Job.CallbackState.Computer)
+    $probeId = [string]$Job.CallbackState.ProbeId
+    $wasCurrent = (-not [string]::IsNullOrWhiteSpace($probeId) -and [string]$script:ActiveLinkProbeId -eq $probeId)
+    Receive-AdccComputerUserProbeProgress -Job $Job
+    Clear-AdccComputerUserProbeState -ProbeId $probeId -Computer $computer
+    $elapsed = [Math]::Max(0,[int]((Get-Date)-$Job.Started).TotalSeconds)
+    Write-AppLog ("Association interrompue : {0} [probe={1}], apres {2}s, motif={3}, remplacee={4}." -f $computer,$probeId,$elapsed,$Reason,[bool]$Job.Superseded) 'WARN'
+    if ($wasCurrent -and -not [bool]$Job.Superseded -and -not [bool]$Job.TimeoutErrorDelivered -and
+        (Get-CurrentSelectedComputerName) -ieq $computer) {
+        [void](Set-AdccControlText -Name 'LblLinkProbeStatus' -Text ("Detection annulee pour {0}. Association en cache conservee ; relance possible apres nettoyage." -f $computer))
+    }
+    if ((Get-CurrentSelectedComputerName) -ieq $computer) { Refresh-AssociationContext -SkipResultRefresh }
+}
