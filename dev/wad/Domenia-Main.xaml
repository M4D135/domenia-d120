                            </StackPanel>
                          </DockPanel>
                          <TextBlock x:Name="LblAccountRemoteIdentity" Text="Repli sur le compte AD courant." VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,10" FontWeight="SemiBold"/>
