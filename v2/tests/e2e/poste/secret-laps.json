{
  "$schema": "../scenario.schema.json",
  "name": "Poste : afficher puis masquer le mot de passe LAPS",
  "description": "Lit l’état LAPS de PC-PAR-0001 (métadonnées), affiche le mot de passe fictif sur un second geste, vérifie le décompte de 30 secondes, puis le masque.",
  "modes": [
    "simulation"
  ],
  "start": "poste?nom=PC-PAR-0001&vue=secrets",
  "steps": [
    {
      "do": "click",
      "selector": "[data-slot=laps] [data-act=laps]",
      "title": "Lire l’état LAPS"
    },
    {
      "do": "wait",
      "selector": "[data-act=lapsReveal]",
      "title": "Le mot de passe est lisible"
    },
    {
      "do": "click",
      "selector": "[data-act=lapsReveal]",
      "title": "Afficher le mot de passe (second geste)"
    },
    {
      "do": "expect",
      "selector": ".ps-shown .ps-secret-value",
      "title": "La valeur est affichée seule"
    },
    {
      "do": "expect",
      "contains": "valeur fictive",
      "within": ".ps-shown",
      "title": "La valeur fictive est signalée"
    },
    {
      "do": "click",
      "selector": "[data-act=hide]",
      "title": "Masquer"
    },
    {
      "do": "expect",
      "selector": ".ps-shown",
      "absent": true,
      "title": "La valeur a disparu de la page"
    },
    {
      "do": "journal",
      "contains": "[ERREUR]",
      "absent": true
    }
  ]
}
