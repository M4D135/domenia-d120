<?xml version='1.0' encoding='utf-8'?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="FILPRO · Connexion" Width="480" SizeToContent="Height" MinWidth="340" MinHeight="0" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="{DynamicResource BgWindow}" Foreground="{DynamicResource FgText}" FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" xml:lang="fr-FR">
  <Window.Resources>
    <!--FILPRO_RESOURCES-->
  </Window.Resources>
  <Grid x:Name="LoginRoot">
    <!-- Only the input area can scroll on a very small desktop. Actions remain outside it. -->
    <Border x:Name="PanelLogin" Style="{StaticResource Card}" Margin="16" Padding="20">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid x:Name="LoginHeader" Grid.Row="0" Margin="0,0,0,18">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource AddBg}" VerticalAlignment="Center" Margin="0,0,13,0">
            <TextBlock Text="F" FontSize="27" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" ToolTipService.ShowOnDisabled="True"/>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="Connexion à FILPRO" FontSize="22" FontWeight="SemiBold" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" ToolTipService.ShowOnDisabled="True"/>
            <TextBlock Text="Compte administrateur requis" Style="{StaticResource Muted}" LineHeight="16" Margin="0,3,0,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" ToolTipService.ShowOnDisabled="True"/>
          </StackPanel>
          <Button x:Name="BtnLoginTheme" Grid.Column="2" Width="36" Height="36" MinHeight="36" Padding="7" Margin="8,0,0,0" VerticalAlignment="Center" KeyboardNavigation.TabIndex="6" ToolTip="Choisir le thème clair ou sombre. Le choix suit votre session Windows, y compris après connexion avec un compte administrateur différent." ToolTipService.ShowOnDisabled="True" ToolTipService.InitialShowDelay="400" ToolTipService.ShowDuration="30000" AutomationProperties.Name="Changer le thème" AutomationProperties.HelpText="Le thème choisi est conservé pour la connexion, le chargement et toutes les fenêtres FILPRO."/>
        </Grid>

        <ScrollViewer x:Name="LoginFormScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" Focusable="False" Padding="0">
          <StackPanel x:Name="LoginFields">
            <Label Content="Compte Windows" Target="{Binding ElementName=TxtUser}" Padding="0" Margin="0,0,0,5" ToolTip="{Binding Content, RelativeSource={RelativeSource Self}}" ToolTipService.ShowOnDisabled="True"/>
            <TextBox x:Name="TxtUser" MaxLength="256" MinHeight="40" Padding="11,7" VerticalContentAlignment="Center" Margin="0,0,0,14" KeyboardNavigation.TabIndex="0" ToolTip="Compte administrateur Windows. Formats acceptés : nom du compte, DOMAINE\compte ou compte@domaine. Aucun choix de domaine séparé n’est nécessaire." ToolTipService.ShowOnDisabled="True" ToolTipService.InitialShowDelay="400" ToolTipService.ShowDuration="30000" AutomationProperties.HelpText="Compte administrateur Windows. Formats acceptés : nom du compte, DOMAINE\compte ou compte@domaine. Aucun choix de domaine séparé n’est nécessaire." AutomationProperties.Name="Compte administrateur Windows"/>
            <Label Content="Mot de passe" Target="{Binding ElementName=TxtPwd}" Padding="0" Margin="0,0,0,5" ToolTip="{Binding Content, RelativeSource={RelativeSource Self}}" ToolTipService.ShowOnDisabled="True"/>
            <PasswordBox x:Name="TxtPwd" MinHeight="40" Padding="11,7" VerticalContentAlignment="Center" Margin="0,0,0,8" KeyboardNavigation.TabIndex="1" ToolTip="Mot de passe du compte saisi. Il est utilisé pour la vérification Windows, n’est jamais sauvegardé dans les préférences et le champ est vidé après la tentative." ToolTipService.ShowOnDisabled="True" ToolTipService.InitialShowDelay="400" ToolTipService.ShowDuration="30000" AutomationProperties.HelpText="Mot de passe du compte saisi. Il est utilisé pour la vérification Windows, n’est jamais sauvegardé dans les préférences et le champ est vidé après la tentative." AutomationProperties.Name="Mot de passe du compte"/>
            <TextBlock x:Name="LblCapsLock" Text="Verr. Maj activé : le mot de passe distingue les majuscules." Visibility="Collapsed" Foreground="{DynamicResource WarnFg}" FontSize="12" Margin="0,0,0,8" ToolTip="Désactivez Verr. Maj si les majuscules ne sont pas souhaitées." ToolTipService.ShowOnDisabled="True" AutomationProperties.LiveSetting="Polite"/>
            <CheckBox x:Name="ChkRemember" FontSize="12" MinHeight="28" Margin="0" KeyboardNavigation.TabIndex="2" ToolTip="Conserve uniquement l’identifiant pour la prochaine connexion. Le mot de passe n’est jamais mémorisé." ToolTipService.ShowOnDisabled="True" ToolTipService.InitialShowDelay="400" ToolTipService.ShowDuration="30000" AutomationProperties.HelpText="Conserve uniquement l’identifiant pour la prochaine connexion. Le mot de passe n’est jamais mémorisé." AutomationProperties.Name="Mémoriser uniquement l’identifiant">
              <TextBlock Text="Mémoriser uniquement l’identifiant" TextWrapping="Wrap" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" ToolTipService.ShowOnDisabled="True"/>
            </CheckBox>
          </StackPanel>
        </ScrollViewer>

        <StackPanel x:Name="LoginActions" Grid.Row="2" Margin="0,16,0,0">
          <!-- A long Windows error never pushes the buttons out of the window. -->
          <Border x:Name="LoginError" Visibility="{Binding Visibility, ElementName=LblErr}" Background="{DynamicResource ErrBg}" BorderBrush="{DynamicResource ErrBorder}" BorderThickness="1" CornerRadius="9" Padding="10,8" Margin="0,0,0,10">
            <ScrollViewer x:Name="LoginErrorScroll" MaxHeight="60" Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <TextBlock x:Name="LblErr" Foreground="{DynamicResource ErrFg}" FontSize="12" LineHeight="17" TextWrapping="Wrap" Visibility="Collapsed" Margin="0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" ToolTipService.ShowOnDisabled="True"/>
            </ScrollViewer>
          </Border>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnCancel" Grid.Column="0" Content="Annuler" IsCancel="True" MinWidth="96" MinHeight="40" Padding="14,8" Margin="0,0,8,0" KeyboardNavigation.TabIndex="5" ToolTip="Ferme la connexion sans ouvrir FILPRO et sans intervenir sur les profils." ToolTipService.ShowOnDisabled="True" ToolTipService.InitialShowDelay="400" ToolTipService.ShowDuration="30000" AutomationProperties.HelpText="Ferme la connexion sans ouvrir FILPRO et sans intervenir sur les profils." AutomationProperties.Name="Annuler"/>
            <Button x:Name="BtnOk" Grid.Column="1" Content="Se connecter" Style="{StaticResource Run}" MinHeight="40" Padding="14,8" Margin="0" KeyboardNavigation.TabIndex="3" ToolTip="Vérifie les identifiants et les droits du compte, puis ouvre FILPRO. Windows peut demander une élévation UAC." ToolTipService.ShowOnDisabled="True" ToolTipService.InitialShowDelay="400" ToolTipService.ShowDuration="30000" AutomationProperties.HelpText="Vérifie les identifiants et les droits du compte, puis ouvre FILPRO. Windows peut demander une élévation UAC." AutomationProperties.Name="Se connecter"/>
          </Grid>
          <Button x:Name="BtnSso" Content="Utiliser mon compte Windows" MinHeight="36" Padding="10,7" Margin="0,8,0,0" KeyboardNavigation.TabIndex="4" ToolTip="Utilise votre session Windows actuelle. Une autorisation UAC et des droits administrateur restent nécessaires pour les opérations réelles." ToolTipService.ShowOnDisabled="True" ToolTipService.InitialShowDelay="400" ToolTipService.ShowDuration="30000" AutomationProperties.HelpText="Utilise votre session Windows actuelle. Une autorisation UAC et des droits administrateur restent nécessaires pour les opérations réelles." AutomationProperties.Name="Utiliser mon compte Windows"/>
          <TextBlock x:Name="LoginPrivacy" Text="Le mot de passe n’est jamais enregistré." Style="{StaticResource Muted}" FontSize="12" LineHeight="16" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,10,0,0" ToolTip="Seul l’identifiant peut être mémorisé. Windows peut demander une autorisation UAC avant l’ouverture de FILPRO." ToolTipService.ShowOnDisabled="True"/>
        </StackPanel>
      </Grid>
    </Border>

    <Border x:Name="PanelSplash" Style="{StaticResource Card}" Visibility="Collapsed" Margin="16" Padding="24" VerticalAlignment="Center">
      <StackPanel>
        <TextBlock Text="Ouverture de FILPRO" FontSize="22" FontWeight="SemiBold" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" ToolTipService.ShowOnDisabled="True"/>
        <TextBlock x:Name="LblStep" Text="Vérification du compte…" Style="{StaticResource Muted}" Margin="0,10,0,18" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" ToolTipService.ShowOnDisabled="True"/>
        <ProgressBar x:Name="SplashProgress" Height="6" Minimum="0" Maximum="100" Value="0" ToolTip="Avancement des étapes de connexion et de chargement. Les étapes ne correspondent pas à une estimation du temps restant." ToolTipService.ShowOnDisabled="True" ToolTipService.InitialShowDelay="400" ToolTipService.ShowDuration="30000" AutomationProperties.HelpText="Avancement des étapes de connexion et de chargement. Les étapes ne correspondent pas à une estimation du temps restant." AutomationProperties.Name="Étapes d’ouverture de FILPRO"/>
        <TextBlock x:Name="LblPct" Text="0 %" Style="{StaticResource Muted}" HorizontalAlignment="Right" Margin="0,8,0,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" ToolTipService.ShowOnDisabled="True"/>
        <Button x:Name="BtnCloseWait" Content="Fermer cette attente" Visibility="Collapsed" Margin="0,16,0,0" MinHeight="36" ToolTip="Ferme uniquement cette fenêtre d’attente. Le processus FILPRO et la demande UAC ne sont pas arrêtés de force ; FILPRO peut encore s’ouvrir." ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Fermer la fenêtre d’attente" AutomationProperties.HelpText="Le processus relaye peut continuer. Aucune operation n’est annulee ou arretee de force."/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
