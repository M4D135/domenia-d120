{
  "$schema": "../scenario.schema.json",
  "name": "Requêtes : paramètre borné et contrôlé en direct",
  "description": "Ajoute « Espace libre C: relevé (%) est inférieur à 15 », en fait le paramètre Seuil borné de 5 à 50, vérifie qu’une valeur hors bornes est refusée en direct (bouton désactivé) puis applique une valeur admise. Aucune lecture réseau.",
  "modes": ["simulation"],
  "start": "requetes?cible=computer",
  "steps": [
    { "do": "wait", "selector": ".rq-combo input", "title": "Le sélecteur d’informations est prêt" },
    { "do": "click", "selector": ".rq-combo input" },
    { "do": "type", "selector": ".rq-combo input", "text": "espace libre", "clear": true },
    { "do": "wait", "contains": "Espace libre C: relevé (%)", "within": ".rq-combo-list" },
    { "do": "press", "key": "Enter" },
    { "do": "click", "text": "est inférieur à", "within": ".rq-ops" },
    { "do": "type", "selector": ".rq-value-host input", "text": "15", "clear": true },
    { "do": "click", "text": "Ajouter le critère", "within": ".rq-builder" },
    { "do": "expect", "contains": "Espace libre", "within": ".rq-crit-list", "title": "Le critère est listé" },
    { "do": "click", "selector": ".rq-crit-list .rq-crit-main", "title": "Sélectionner le critère à paramétrer" },
    { "do": "click", "selector": "[data-fold=\"params\"] > summary", "title": "Ouvrir les paramètres réutilisables" },
    { "do": "expect", "selector": ".rq-param-min", "title": "Bornes proposées pour une information numérique" },
    { "do": "type", "selector": ".rq-param-name", "text": "Seuil", "clear": true },
    { "do": "type", "selector": ".rq-param-label", "text": "Seuil d’espace libre", "clear": true },
    { "do": "type", "selector": ".rq-param-min", "text": "5", "clear": true },
    { "do": "type", "selector": ".rq-param-max", "text": "50", "clear": true },
    { "do": "click", "text": "Paramétrer le critère sélectionné", "within": ".rq-param-new" },
    { "do": "wait", "selector": ".rq-param-row[data-name=\"Seuil\"]", "title": "Le paramètre est créé" },
    { "do": "expect", "contains": "paramètre Seuil", "within": ".rq-crit-list", "title": "Le critère utilise le paramètre" },
    { "do": "type", "selector": ".rq-param-value[data-name=\"Seuil\"]", "text": "80", "clear": true },
    { "do": "wait", "contains": "au-dessus du maximum", "within": ".rq-param-row[data-name=\"Seuil\"]", "title": "Contrôle en direct avant « Appliquer »" },
    { "do": "expect", "selector": "[data-param=\"apply\"][data-name=\"Seuil\"]", "property": "disabled", "equals": true },
    { "do": "type", "selector": ".rq-param-value[data-name=\"Seuil\"]", "text": "20", "clear": true },
    { "do": "wait", "selector": ".rq-param-check.ok[data-check=\"Seuil\"]", "title": "Valeur admise" },
    { "do": "click", "text": "Appliquer la valeur", "within": ".rq-param-row[data-name=\"Seuil\"]" },
    { "do": "wait", "contains": "Seuil", "within": ".rq-summary-card", "title": "Le résumé montre le paramètre et sa valeur" },
    { "do": "shot", "name": "parametre", "selector": ".rq-params" },
    { "do": "journal", "contains": "[ERREUR]", "absent": true }
  ]
}
