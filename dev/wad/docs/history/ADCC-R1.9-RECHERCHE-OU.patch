+    $includeChildren = ($null -eq $subtree -or [bool]$subtree.IsChecked)
+    [pscustomobject]@{
+        BaseDn = $baseDn
+        Scope = $(if ($includeChildren) { 'Subtree' } else { 'OneLevel' })
+        IsDomain = [string]::Equals($baseDn,$domainDn,[StringComparison]::OrdinalIgnoreCase)
+    }
+}
