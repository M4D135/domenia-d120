{
  "$schema": "../scenario.schema.json",
  "name": "Accueil : choisir et appliquer l’OU de travail",
  "description": "Ouvre le panneau « Choisir l’OU » depuis la carte de l’OU de travail, déplie l’OU Postes au clavier, sélectionne Lyon, l’applique, puis vérifie que l’Accueil est recalculé sur cette OU sans lecture réseau.",
  "modes": ["simulation"],
  "start": "accueil",
  "steps": [
    { "do": "expect", "text": "Postes", "within": ".scope-card .scope-name", "title": "L’OU de travail de départ est « Postes »" },
    { "do": "click", "text": "Choisir l’OU", "within": ".scope-card" },
    { "do": "expect", "selector": ".ou-panel[role=dialog]", "title": "Le panneau « Choisir l’OU de travail » est ouvert" },
    { "do": "wait", "text": "Postes", "within": ".ou-tree", "title": "L’arborescence des OU est lue" },
    { "do": "click", "text": "Postes", "within": ".ou-tree", "title": "Sélectionner l’OU Postes dans l’arborescence" },
    { "do": "press", "key": "ArrowRight", "title": "Déplier Postes au clavier (flèche droite)" },
    { "do": "click", "text": "Lyon", "within": ".ou-tree", "title": "Sélectionner l’OU Lyon sous Postes" },
    { "do": "expect", "contains": "Lyon", "within": ".ou-pick", "title": "La sélection affiche Lyon" },
    { "do": "expect", "selector": "[data-ou-apply]", "within": ".ou-panel", "property": "disabled", "equals": false, "title": "« Appliquer » est disponible" },
    { "do": "shot", "name": "panneau-ou", "selector": ".ou-panel" },
    { "do": "click", "text": "Appliquer", "within": ".ou-panel" },
    { "do": "expect", "selector": ".ou-panel", "absent": true, "title": "Le panneau se referme" },
    { "do": "expect", "text": "Lyon", "within": ".scope-card .scope-name", "title": "La carte affiche la nouvelle OU de travail" },
    { "do": "expect", "contains": "OU de travail : Lyon et ses sous-OU.", "within": ".toasts", "title": "La notification confirme le recalcul sans lecture réseau" },
    { "do": "journal", "contains": "Mode E2E actif" },
    { "do": "journal", "contains": "[ERREUR]", "absent": true }
  ]
}
