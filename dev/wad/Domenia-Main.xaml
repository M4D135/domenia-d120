                <Grid Width="38" Height="38" IsHitTestVisible="False">
                  <TextBlock Text="?" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  <!-- UI-11: dot of the first launch on « ? », gone once the help is opened (UxHelpIntroSeen). -->
                  <Ellipse x:Name="UxHelpBadge" Width="9" Height="9" Fill="{DynamicResource AccentColor}" Stroke="{DynamicResource BgCard}" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="{DynamicResource MarginHelpBadge}" Visibility="Collapsed"/>
                </Grid>
