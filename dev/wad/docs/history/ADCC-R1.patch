 # Aucun processus PowerShell enfant n est cree par ADCC.
 # ---------------------------------------------------------------------
+# ADCC Reliability R1 - helpers loaded before bootstrap; Windows PowerShell 5.1.
+# These functions do not start network requests, background scans or services.
+function Write-AdccAtomicText {
+    [CmdletBinding()]
+    param([Parameter(Mandatory)][string]$LiteralPath,[Parameter(Mandatory)][AllowEmptyString()][string]$Value,[switch]$KeepBackup)
+    $full = [IO.Path]::GetFullPath($LiteralPath)
+    $dir = [IO.Path]::GetDirectoryName($full)
+    if (-not [IO.Directory]::Exists($dir)) { [void][IO.Directory]::CreateDirectory($dir) }
+    $temp = Join-Path $dir ('.adcc-' + [guid]::NewGuid().ToString('N') + '.tmp')
+    $stream = $null
+    try {
+        $bytes = [Text.UTF8Encoding]::new($false).GetBytes($Value)
+        $stream = [IO.FileStream]::new($temp,[IO.FileMode]::CreateNew,[IO.FileAccess]::Write,[IO.FileShare]::None)
+        $stream.Write($bytes,0,$bytes.Length)
+        $stream.Flush($true)
+        $stream.Dispose(); $stream = $null
+        if ([IO.File]::Exists($full)) {
+            $backup = if ($KeepBackup) { $full + '.bak' } else { $null }
+            # Same-directory replacement. Never delete the valid destination first.
+            [IO.File]::Replace($temp,$full,$backup,$true)
+        } else { [IO.File]::Move($temp,$full) }
+    }
+    finally {
+        if ($null -ne $stream) { $stream.Dispose() }
+        if ([IO.File]::Exists($temp)) { [IO.File]::Delete($temp) }
+    }
+}
+
+function Protect-AdccLogText {
+    param([AllowNull()][AllowEmptyString()][string]$Text)
+    $value = [string]$Text
+    # Defence in depth, not a promise to recognise every possible secret.
+    $value = [regex]::Replace($value,'(?i)\b(Bearer|Basic)\s+[A-Za-z0-9_.~+/=-]+','$1 [MASQUE]')
+    $value = [regex]::Replace($value,'(?i)\b(password|passwd|pwd|mot\s+de\s+passe|token|authorization|api[_-]?key|client[_-]?secret)\s*[:=]\s*(?:"[^"]*"|''[^'']*''|[^\s;,]+)','$1=[MASQUE]')
+    $value = [regex]::Replace($value,'(?i)("(?:password|passwd|pwd|p|token|api[_-]?key|client[_-]?secret)"\s*:\s*)("(?:\\.|[^"\\])*"|[^,}\s]+)','$1"[MASQUE]"')
+    $value = [regex]::Replace($value,'(?i)(^|\s)(-p|-password)\s+(?:"[^"]*"|''[^'']*''|\S+)','$1$2 [MASQUE]')
+    $value = [regex]::Replace($value,'(?<!\d)(?:\d{6}-){7}\d{6}(?!\d)','[CLE BITLOCKER MASQUEE]')
+    try {
+        foreach ($row in @($script:SecretRows)) {
+            $secret = [string]$row.Value
+            if ($secret.Length -ge 4) { $value = $value.Replace($secret,'[SECRET MASQUE]') }
+        }
+        $clipboard = [string]$script:SecretClipboardValue
+        if ($clipboard.Length -ge 4) { $value = $value.Replace($clipboard,'[SECRET MASQUE]') }
+    } catch { }
+    return $value
+}
+
+function ConvertTo-AdccSpreadsheetCell {
+    param($Value)
+    if ($null -eq $Value) { return $null }
+    # Preserve numeric values, booleans and dates. Only untrusted text is escaped.
+    if ($Value -isnot [string]) { return $Value }
+    if ($Value -match '^[\s\p{Cf}]*[=+@\-\uFF1D\uFF0B\uFF0D\uFF20]' -or $Value -match '^[\t\r\n]') {
+        return "'" + $Value
+    }
+    return $Value
+}
+
+function ConvertTo-AdccSpreadsheetSafeRow {
+    [CmdletBinding()]
+    param([Parameter(ValueFromPipeline=$true)]$InputObject)
+    process {
+        if ($null -ne $InputObject) {
+            $safe = [ordered]@{}
+            foreach ($property in $InputObject.PSObject.Properties) {
+                if ($property.MemberType -notin @('NoteProperty','Property','AliasProperty','ScriptProperty')) { continue }
+                $name = [string](ConvertTo-AdccSpreadsheetCell ([string]$property.Name))
+                $safe[$name] = ConvertTo-AdccSpreadsheetCell $property.Value
+            }
+            [pscustomobject]$safe
+        }
+    }
+}
+
+function ConvertTo-AdccSqlLikeText {
+    param([AllowEmptyString()][string]$Value)
+    # SQL quoting and LIKE escaping are independent operations.
+    return $Value.Replace('!','!!').Replace('%','!%').Replace('_','!_')
+}
+
+function Get-AdccScopeKey {
+    param([Parameter(Mandatory)][string]$BaseDn)
+    $sha = [Security.Cryptography.SHA256]::Create()
+    try {
+        $bytes = [Text.Encoding]::UTF8.GetBytes($BaseDn.Trim().ToLowerInvariant())
+        return ([BitConverter]::ToString($sha.ComputeHash($bytes))).Replace('-','').Substring(0,32).ToLowerInvariant()
+    } finally { $sha.Dispose() }
+}
