{
  "$schema": "../scenario.schema.json",
  "name": "Opérations : en-tête compact dès qu’un onglet est ouvert, dépliable à la demande",
  "description": "Une adresse qui vise un onglet ouvre l’écran avec l’en-tête compact (les onglets commencent haut dans l’écran) ; le bouton de l’en-tête le déplie puis le replie, sans rien relire.",
  "modes": ["simulation"],
  "start": "operations?onglet=taches",
  "steps": [
    { "do": "wait", "ready": "operations", "title": "L’écran est prêt" },
    { "do": "expect", "selector": ".op-hero", "attribute": "data-compact", "equals": "true", "title": "En-tête compact" },
    { "do": "expect", "selector": ".op-hero-lead", "absent": true, "title": "La phrase d’introduction est repliée" },
    { "do": "shot", "name": "entete-compact", "selector": ".op-page" },
    { "do": "click", "selector": "[data-act=\"fold\"]", "title": "Afficher l’en-tête complet" },
    { "do": "expect", "selector": ".op-hero", "attribute": "data-compact", "equals": "false", "title": "En-tête complet" },
    { "do": "expect", "selector": ".op-circuit-steps li", "within": ".op-circuit", "count": 5, "title": "Les cinq temps du circuit sont visibles" },
    { "do": "click", "selector": "[data-act=\"fold\"]", "title": "Réduire l’en-tête" },
    { "do": "expect", "selector": ".op-hero", "attribute": "data-compact", "equals": "true" },
    { "do": "journal", "contains": "[ERREUR]", "absent": true }
  ]
}
