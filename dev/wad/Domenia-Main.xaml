                        <Path Data="M6,6 L18,18 M18,6 L6,18" Width="8" Height="8" Stretch="Uniform" Stroke="{DynamicResource MutedColor}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False"/>
