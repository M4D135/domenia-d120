+function Get-AdccStoreBackupDirectory {
+    $path = Join-Path ([IO.Path]::GetDirectoryName((Get-AdccDatabasePath))) 'Backups'
+    if (-not [IO.Directory]::Exists($path)) { [void][IO.Directory]::CreateDirectory($path) }
+    return $path
+}
