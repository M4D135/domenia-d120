+function Get-DomeniaEmbeddedLookupCode {
+@'
+$kind=[string]$Payload.Kind
+if($kind -notin @('Machine','Utilisateur','OU')){throw 'Type de recherche non autorisé.'}
+$term=([string]$Payload.Term).Trim()
