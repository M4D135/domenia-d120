+function Update-AdccSearchScopeUi {
+    if ([string]::IsNullOrWhiteSpace([string]$script:Conn.BaseDn)) { return }
+    $scope = Get-AdccSearchScope
+    [void](Set-AdccControlText -Name 'TxtBranchDn' -Text ([string]$scope.BaseDn))
+    $label = if ($scope.IsDomain) { 'Tout le domaine' } else { [string]$scope.BaseDn }
+    $depth = if ($scope.Scope -eq 'Subtree') { 'Sous-OU incluses' } else { 'Enfants directs uniquement' }
+    $summary = Get-AdccControl -Name 'LblSearchScope'
+    if ($null -ne $summary) {
+        $summary.Text = "Dans : $label  |  $depth"
