{
  "$schema": "../scenario.schema.json",
  "name": "Poste : arrêter un inventaire garde ce qui est déjà lu",
  "description": "Lance l’inventaire complet de PC-PAR-0001 puis l’arrête : le résultat partiel est affiché et enregistré (sources lues gardées, les autres « Interrompu »), jamais une perte.",
  "modes": [
    "simulation"
  ],
  "start": "poste?nom=PC-PAR-0001&vue=inventaire",
  "timeoutMs": 30000,
  "steps": [
    { "do": "click", "selector": "[data-act=deep]", "within": ".ps-inv-actions", "title": "Inventaire complet" },
    { "do": "wait", "selector": "[data-act=stop]:not([hidden])", "within": ".ps-inv-actions", "title": "L’inventaire est en cours" },
    { "do": "click", "selector": "[data-act=stop]", "within": ".ps-inv-actions", "title": "Arrêter" },
    { "do": "wait", "contains": "Résultat partiel", "title": "Le résultat partiel est dit" },
    { "do": "expect", "contains": "Interrompu", "within": ".ps-access", "title": "Les sources non lues sont « Interrompu »" },
    { "do": "journal", "contains": "[ERREUR]", "absent": true }
  ]
}
