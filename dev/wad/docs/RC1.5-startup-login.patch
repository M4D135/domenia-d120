+function Assert-DomeniaWorkerRegistry {
+    [CmdletBinding()]
+    param([AllowNull()][System.Collections.IDictionary]$Registry = (Get-DomeniaWorkerOperationHashes))
+    # Pin the entire reviewed map, not a separately maintained operation counter.
+    # This digest is updated only by the DEV release tool after contract review.
+    $expectedFingerprint = "925DC83121296F7C47AE08EA0F2BD23C578CCCFA066BB18613A4ED3B0236A209"
+    if ($null -eq $Registry -or $Registry.Count -eq 0) {
+        throw 'Registre worker absent ou vide.'
+    }
+    [string[]]$names = @($Registry.Keys)
+    [Array]::Sort($names,[StringComparer]::Ordinal)
+    $records = [Collections.Generic.List[string]]::new()
+    foreach ($name in $names) {
+        if ($name -cnotmatch '^[A-Za-z][A-Za-z0-9]{2,63}$') { throw 'Identifiant du registre worker invalide.' }
+        $hash = [string]$Registry[$name]
+        if ($hash -cnotmatch '^[A-F0-9]{64}$') { throw "Empreinte worker invalide pour $name." }
+        $records.Add($name + '=' + $hash)
+    }
+    $canonical = [string]::Join("`n",$records.ToArray())
+    $actual = Get-DomeniaWorkerCodeHash -Code $canonical
+    if (-not [string]::Equals($actual,$expectedFingerprint,[StringComparison]::Ordinal)) {
+        throw ("Registre worker non conforme ({0} operation(s), empreinte={1}). Composant manquant, ajoute ou modifie ; reinstallez un paquet coherent." -f $Registry.Count,$actual)
+    }
+    return [int]$Registry.Count
+}
