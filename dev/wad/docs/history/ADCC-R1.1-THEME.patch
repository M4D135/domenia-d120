+    </Style>
+    <Style TargetType="ToolTip">
+      <Setter Property="Foreground" Value="{DynamicResource AdccBootText}"/>
+      <Setter Property="Background" Value="{DynamicResource AdccBootSurface}"/>
+      <Setter Property="BorderBrush" Value="{DynamicResource AdccBootBorder}"/>
+      <Setter Property="Padding" Value="8"/>
+    </Style>
+'@
+    return (($brushes -join "`r`n") + "`r`n" + $styles)
