{
  "$schema": "../scenario.schema.json",
  "name": "Utilisateurs et postes : moisson du journal et mémorisation automatique",
  "description": "Estime puis lance la moisson du journal du contrôleur (simulation), vérifie que les nouveaux couples sont mémorisés automatiquement dans la base locale par lots de 64, sans confirmation (choix du 22/10), et que le panneau reste ouvert avec l’avancement.",
  "modes": [
    "simulation"
  ],
  "start": "relations?panneau=moisson",
  "steps": [
    {
      "do": "wait",
      "selector": "[data-rf=\"estimate\"]",
      "title": "Le panneau de moisson est ouvert"
    },
    {
      "do": "click",
      "selector": "[data-rf=\"estimate\"]",
      "title": "Estimer l’impact"
    },
    {
      "do": "wait",
      "selector": "[data-rf=\"run\"]",
      "title": "L’impact estimé est à confirmer"
    },
    {
      "do": "click",
      "selector": "[data-rf=\"run\"]",
      "title": "Lancer la moisson"
    },
    {
      "do": "wait",
      "selector": ".rel-harvest-grid .k-gr",
      "timeoutMs": 20000,
      "title": "Les couples lus sont listés"
    },
    {
      "do": "shot",
      "name": "moisson-couples",
      "selector": ".rel-panel"
    },
    {
      "do": "wait",
      "contains": "mémorisés",
      "within": ".rel-harvest-progress",
      "title": "Les nouveaux couples sont mémorisés automatiquement, sans confirmation"
    },
    {
      "do": "expect",
      "contains": "Tout est mémorisé",
      "title": "Plus rien à mémoriser"
    },
    {
      "do": "expect",
      "selector": ".rel-pending",
      "absent": true,
      "title": "Aucun bandeau d’observations en attente"
    },
    {
      "do": "go",
      "route": "relations?onglet=journal",
      "title": "Journal des associations"
    },
    {
      "do": "wait",
      "contains": "Mémorisation automatique, lot 2",
      "title": "Chaque lot mémorisé est tracé au journal des associations"
    },
    {
      "do": "journal",
      "contains": "[ERREUR]",
      "absent": true
    }
  ]
}
