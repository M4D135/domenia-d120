                          <TextBlock x:Name="LblAccountRemoteStatus" Text="Identifiant mémorisé dans la base ; le mot de passe nʼest jamais conservé." Foreground="{DynamicResource MutedColor}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                      </Border>
                      <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,14">
