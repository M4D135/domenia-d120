+function Get-WRemoteComputerName {
+    param([string]$Computer)
+    $name = ([string]$Computer).Trim()
+    # Une seule cible. Refuser les jokers, listes, chemins et options natives.
+    if ($name -notmatch '\A[A-Za-z0-9][A-Za-z0-9_.-]{0,252}\z') {
+        throw 'Nom de poste distant invalide : fournir un nom DNS, NetBIOS ou une adresse IPv4 unique.'
+    }
+    return $name
+}
+function Format-WRemoteFailureDetail {
+    param([string]$Text,[int]$MaxLength=700)
+    $detail = ([regex]::Replace(([string]$Text),'\s+',' ')).Trim()
+    if ([string]::IsNullOrWhiteSpace($detail)) { return 'aucun detail retourne' }
+    if ($detail -match '(?i)SYSINTERNALS SOFTWARE LICENSE TERMS|BY USING THE SOFTWARE, YOU ACCEPT THESE TERMS') {
+        return 'PsExec a renvoye sa licence au lieu du resultat distant. Verifier la ligne de commande, les options -accepteula/-nobanner et le binaire lance ; ce retour ne prouve pas un refus de droits sur la cible.'
+    }
+    $limit = [Math]::Max(80,$MaxLength)
+    if ($detail.Length -gt $limit) { return ($detail.Substring(0,$limit)+' [...]') }
+    return $detail
+}
+function Get-WProbeAttemptSummary {
+    param([object[]]$Attempts)
+    $parts = New-Object 'System.Collections.Generic.List[string]'
+    foreach ($attempt in @($Attempts)) {
+        if ([string]$attempt.Status -in @('INFO','OK')) { continue }
+        $detail = Format-WRemoteFailureDetail -Text ([string]$attempt.Detail) -MaxLength 220
+        $parts.Add(('{0} [{1}] : {2}' -f [string]$attempt.Method,[string]$attempt.Status,$detail))
+        if ($parts.Count -ge 6) { break }
+    }
+    if ($parts.Count -eq 0) { return 'Aucun resultat classique exploitable.' }
+    return ($parts.ToArray() -join ' | ')
+}
