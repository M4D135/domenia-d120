                        </StackPanel>
                        <DataGrid x:Name="DgPermissions" AutoGenerateColumns="False" IsReadOnly="True" MinRowHeight="31" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Estimation par action">
