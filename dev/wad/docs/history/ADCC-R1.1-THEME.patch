+        '    <SolidColorBrush x:Key="AdccBoot{0}" Color="{1}"/>' -f $entry.Key,$entry.Value
+    }
+    # Styles explicites : les styles systeme Windows ne doivent pas reinjecter
+    # une police noire ou un bouton blanc au survol sur une surface sombre.
+    $styles = @'
+    <Style x:Key="AdccBootTextBoxBase" TargetType="TextBox">
+      <Setter Property="Foreground" Value="{DynamicResource AdccBootText}"/>
+      <Setter Property="Background" Value="{DynamicResource AdccBootInput}"/>
+      <Setter Property="BorderBrush" Value="{DynamicResource AdccBootBorder}"/>
+      <Setter Property="CaretBrush" Value="{DynamicResource AdccBootText}"/>
+      <Setter Property="SelectionBrush" Value="{DynamicResource AdccBootAccent}"/>
+    </Style>
+    <Style x:Key="AdccBootPasswordBoxBase" TargetType="PasswordBox">
+      <Setter Property="Foreground" Value="{DynamicResource AdccBootText}"/>
+      <Setter Property="Background" Value="{DynamicResource AdccBootInput}"/>
+      <Setter Property="BorderBrush" Value="{DynamicResource AdccBootBorder}"/>
+      <Setter Property="CaretBrush" Value="{DynamicResource AdccBootText}"/>
+      <Setter Property="SelectionBrush" Value="{DynamicResource AdccBootAccent}"/>
+    </Style>
+    <Style x:Key="AdccBootButtonBase" TargetType="Button">
+      <Setter Property="Foreground" Value="{DynamicResource AdccBootButtonText}"/>
+      <Setter Property="Background" Value="{DynamicResource AdccBootButton}"/>
+      <Setter Property="BorderBrush" Value="{DynamicResource AdccBootBorder}"/>
+      <Setter Property="BorderThickness" Value="1"/>
+      <Setter Property="Cursor" Value="Hand"/>
+      <Setter Property="HorizontalContentAlignment" Value="Center"/>
+      <Setter Property="VerticalContentAlignment" Value="Center"/>
+      <Setter Property="Template">
+        <Setter.Value>
+          <ControlTemplate TargetType="Button">
+            <Border x:Name="BootButtonBorder" Background="{TemplateBinding Background}"
+                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
+                    CornerRadius="8" SnapsToDevicePixels="True">
+              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
+                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
+                                Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
+                                TextElement.Foreground="{TemplateBinding Foreground}"/>
+            </Border>
+            <ControlTemplate.Triggers>
+              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="BootButtonBorder" Property="Opacity" Value="0.92"/></Trigger>
+              <Trigger Property="IsPressed" Value="True"><Setter TargetName="BootButtonBorder" Property="Opacity" Value="0.80"/></Trigger>
+              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="BootButtonBorder" Property="Opacity" Value="0.55"/></Trigger>
+            </ControlTemplate.Triggers>
+          </ControlTemplate>
+        </Setter.Value>
+      </Setter>
+    </Style>
